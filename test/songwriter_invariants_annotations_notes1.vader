" Invariants of annotations through edits on a note (see invariants/setup.vader and
" invariants/annotations.vader).

Include: invariants/setup.vader

Execute (the edits checked here):
  let g:inv_note_keys = ['x', 'dd']
  let g:inv_dash_keys = []
  let g:inv_range_keys = []
  " Spec [[Bugs]] 1: `dd` joins another string's notes.
  let g:inv_known = ['moved c: two-digit frets, 1:9, dd', 'moved d: two-digit frets, 2:20, dd', 'moved c: separators, 2:8, dd']
  " Spec [[Bugs]] 4: a label pushed off its column by the label before it.
  let g:inv_known += [
        \ 'moved c: two-digit frets, 1:9, x', 'moved d: two-digit frets, 1:9, x', 'moved e: two-digit frets, 1:9, x', 'moved d: two-digit frets, 1:9, dd',
        \ 'moved e: two-digit frets, 1:9, dd', 'moved d: two-digit frets, 2:11, x', 'moved e: two-digit frets, 2:11, x', 'moved e: separators, 1:18, x',
        \ 'moved f: separators, 1:18, x', 'moved e: separators, 1:18, dd', 'moved f: separators, 1:18, dd', 'moved c: separators, 2:8, x',
        \ 'moved d: separators, 2:8, x', 'moved e: separators, 2:8, x', 'moved f: separators, 2:8, x', 'moved d: separators, 2:8, dd',
        \ 'moved e: separators, 2:8, dd', 'moved f: separators, 2:8, dd']

Include: invariants/annotations.vader
