" Spec [Tablature][[Editing]] 6.3.2, 6.4, 6.5, 6.7, 6.8, 6.10: erasing (x, X)
" and pasting (p, P) in tablature mode. Typed end-to-end with `normal`.

Before:
  unlet! b:songwriter_tabmode b:songwriter_slot b:songwriter_typing b:songwriter_repeat
  let b:songwriter_tabmode = 1
  call setreg('"', [])

" --- 6.7 x ---

Given songwriter (6.7 x takes no count, not even through `.`):
  e|--3--5--7--9--|

Execute (6.7 x takes no count, not even through `.`):
  call cursor(1, 5)
  normal x
  call songwriter#tab#repeat#Run(2)
Expect songwriter:
  e|--7--9--|

Given songwriter (6.7.1 x on a shared column turns the note into dashes):
  e|--3--5--|
  B|-----5--|

Execute (6.7.1 x on a shared column turns the note into dashes):
  call cursor(1, 8)
  normal x
  AssertEqual ['5--', '---'], getreg('"', 1, 1)
  AssertEqual "\<C-V>3", getregtype('"')
Expect songwriter:
  e|--3-----|
  B|-----5--|

Given songwriter (6.7.2 x on a lone note removes it and its gap):
  e|--3----5--7--|

Execute (6.7.2 x on a lone note removes it and its gap):
  call cursor(1, 10)
  normal x
  AssertEqual 10, col('.')
Expect songwriter:
  e|--3----7--|

Given songwriter (6.7.2 x keeps a dash between the notes of another string):
  e|--5h7--7b--|
  B|-----3-----|

Execute (6.7.2 x keeps a dash between the notes of another string):
  call cursor(2, 8)
  normal x

Expect songwriter (6.7.2 x keeps a dash between the notes of another string):
  e|--5h7-7b--|
  B|----------|

Given songwriter (6.7.2 x keeps the column when removing it would join another string's notes):
  e|--10-12--|
  B|----5----|

Execute (6.7.2 x keeps the column when removing it would join another string's notes):
  call cursor(2, 7)
  normal x

Expect songwriter (6.7.2 x keeps the column when removing it would join another string's notes):
  e|--10-12--|
  B|---------|

Given songwriter (6.7.4 x takes the separators before a note that belong to it):
  e|--3--/5--7--|

Execute (6.7.4 x takes the separators before a note that belong to it):
  call cursor(1, 9)
  normal x

Expect songwriter (6.7.4 x takes the separators before a note that belong to it):
  e|--3---7--|

Given songwriter (6.7.4 x takes the decoration around a note):
  e|--3--(5)--7--|

Execute (6.7.4 x takes the decoration around a note):
  call cursor(1, 9)
  normal x

Expect songwriter (6.7.4 x takes the decoration around a note):
  e|--3---7--|

Given songwriter (6.7.4 x on a shared column turns the note and its separators into dashes):
  e|--3--5~--7--|
  B|-----5------|

Execute (6.7.4 x on a shared column turns the note and its separators into dashes):
  call cursor(1, 8)
  normal x

Expect songwriter (6.7.4 x on a shared column turns the note and its separators into dashes):
  e|--3------7--|
  B|-----5------|

Given songwriter (6.7.4 x takes the separator before the note):
  e|--5h7--|

Execute (6.7.4 x takes the separator before the note):
  call cursor(1, 7)
  normal x

Expect songwriter (6.7.4 x takes the separator before the note):
  e|--5--|

Given songwriter (6.7.3 xp swaps a note with the next one):
  e|--3--5--7--|

Execute (6.7.3 xp swaps a note with the next one):
  call cursor(1, 8)
  normal xp
  AssertEqual 11, col('.')
Expect songwriter:
  e|--3--7--5--|

Given songwriter (6.7.3 xp on a shared column moves the note one column later):
  e|--3--5--|
  B|--1--5--|

Execute (6.7.3 xp on a shared column moves the note one column later):
  call cursor(1, 5)
  normal xp
Expect songwriter:
  e|-----3--5--|
  B|--1-----5--|

Given songwriter (6.7 a named register):
  e|--3--5--|

Execute (6.7 a named register):
  call setreg('a', [])
  call cursor(1, 8)
  normal "ax
  AssertEqual ['5--'], getreg('a', 1, 1)

Given songwriter (3.4.3 x on a dash enters a muted note):
  e|--3--5--|

Execute (3.4.3 x on a dash enters a muted note):
  call cursor(1, 6)
  normal x
Expect songwriter:
  e|--3x-5--|

" --- 6.5 p / P ---

Given songwriter (6.5.1 yac then P duplicates a column before it):
  e|--3--5--|

Execute (6.5.1 yac then P duplicates a column before it):
  call cursor(1, 5)
  normal yacP
  AssertEqual 5, col('.')
Expect songwriter:
  e|--3--3--5--|

Given songwriter (6.5.2 ya| then p duplicates a bar after it):
  e|--3--5--|--8--|
  B|--1-----|-----|

Execute (6.5.2 ya| then p duplicates a bar after it):
  call cursor(1, 5)
  normal ya|p
  AssertEqual 14, col('.')
Expect songwriter:
  e|--3--5--|--3--5--|--8--|
  B|--1-----|--1-----|-----|

Given songwriter (6.5.3 a bass bar pasted into a guitar tab lands on the lowest strings):
  e|-----|
  B|-----|
  G|-----|
  D|-----|
  A|-----|
  E|-----|

  G|--5--|
  D|-----|
  A|--3--|
  E|-----|

Execute (6.5.3 a bass bar pasted into a guitar tab lands on the lowest strings):
  call cursor(8, 4)
  normal ya|
  call cursor(1, 3)
  normal p
Expect songwriter:
  e|-----|-----|
  B|-----|-----|
  G|-----|--5--|
  D|-----|-----|
  A|-----|--3--|
  E|-----|-----|

  G|--5--|
  D|-----|
  A|--3--|
  E|-----|

Given songwriter (6.5.3 different string names where they meet: refused):
  e|--0--|
  B|-----|
  G|-----|
  D|-----|
  A|-----|
  D|--0--|

  G|-----|
  D|-----|
  A|-----|
  E|-----|

Execute (6.5.3 different string names where they meet: refused):
  call cursor(1, 4)
  normal ya|
  call cursor(8, 3)
  normal p
Expect songwriter:
  e|--0--|
  B|-----|
  G|-----|
  D|-----|
  A|-----|
  D|--0--|

  G|-----|
  D|-----|
  A|-----|
  E|-----|

Given songwriter (6.5.4 a character-wise register is refused):
  e|--3--|

Execute (6.5.4 a character-wise register is refused):
  call setreg('"', 'abc', 'c')
  call cursor(1, 5)
  normal p
Expect songwriter:
  e|--3--|

Given songwriter (6.3.2 a line-wise register goes after the tab, apart from it):
  e|--3--|
  B|--1--|
  end

Execute (6.3.2 a line-wise register goes after the tab, apart from it):
  call setreg('"', ['e|--3--|', 'B|--1--|'], 'l')
  call cursor(1, 4)
  normal p
Expect songwriter:
  e|--3--|
  B|--1--|

  e|--3--|
  B|--1--|
  end

Given songwriter (6.3.2 P puts a line-wise register before the tab):
  Intro
  e|--3--|

Execute (6.3.2 P puts a line-wise register before the tab):
  call setreg('"', ['Verse'], 'l')
  call cursor(2, 4)
  normal P
Expect songwriter:
  Intro
  Verse
  e|--3--|

" --- 6.10 repeat and undo ---

Given songwriter (6.10 . repeats x):
  e|--3--5--7--|

Execute (6.10 . repeats x):
  call cursor(1, 5)
  normal x.
Expect songwriter:
  e|--7--|

Given songwriter (6.10 . repeats p):
  e|--3--|

Execute (6.10 . repeats p):
  call cursor(1, 5)
  normal yacp.
Expect songwriter:
  e|--3--3--3--|

Given songwriter (6.10 x is one undo step):
  e|-----3--5--|

Execute (6.10 x is one undo step):
  call cursor(1, 11)
  normal x
  AssertEqual 'e|--3--|', getline(1)
  normal u
Expect songwriter:
  e|-----3--5--|

Given songwriter (6.5.1 a pasted column never joins a note of the tab):
  e|--10-12--|
  B|----5----|

Execute (6.5.1 yyp on the 10, whose gap ends where the 5 starts):
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  normal yyp

Expect songwriter (a dash between the two 10s):
  e|--10-10-12--|
  B|-------5----|

Given songwriter (6.5.1 P never joins a pasted note to the note before the column):
  e|--10-12--|
  B|----5----|

Execute (6.5.1 P of a column on the 5):
  let b:songwriter_tabmode = 1
  call setreg('a', ['7--', '---'], 'b')
  call cursor(2, 7)
  normal "aP

Expect songwriter (a dash between the 10 and the 7):
  e|--10-7---12--|
  B|--------5----|

Given songwriter (6.14 gp never joins a note to the one ending right before its column):
  e|--12-----|
  B|----3----|

Execute (6.14 gp of a 4 on e, on the column of the 3):
  let b:songwriter_tabmode = 1
  call setreg('a', ['4--', '---'], 'b')
  call cursor(2, 7)
  normal "agp

Expect songwriter (a dash between the 12 and the 4):
  e|--12-4--|
  B|-----3--|
