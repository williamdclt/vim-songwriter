" Named states and how long each holds (autoload/songwriter/tab/state.vim).

Before:
  enew!
  call setline(1, ['e|--3--5--|', 'B|--1-----|'])
  let b:songwriter_tabmode = 1
  unlet! b:songwriter_repeat b:songwriter_carry b:songwriter_typing b:songwriter_move
  unlet! b:songwriter_annotating b:songwriter_vobj

Execute ('change' (`.`): the value while the buffer is unchanged, the cursor anywhere, {} after a change):
  call cursor(1, 3)
  call songwriter#tab#state#Set('repeat', {'n': 1})
  AssertEqual 1, songwriter#tab#state#Get('repeat').n
  call cursor(2, 6)
  AssertEqual 1, songwriter#tab#state#Get('repeat').n
  call setline(1, 'e|--4--5--|')
  AssertEqual {}, songwriter#tab#state#Get('repeat')

Execute ('continuation' (the carry): the value while the buffer is unchanged and the cursor where it was recorded):
  call cursor(1, 3)
  call songwriter#tab#state#Set('carry', {'n': 1, 'line': 1, 'col': 3})
  AssertEqual 1, songwriter#tab#state#Get('carry').n
  call cursor(1, 6)
  AssertEqual {}, songwriter#tab#state#Get('carry')
  call cursor(2, 3)
  AssertEqual {}, songwriter#tab#state#Get('carry')
  call cursor(1, 3)
  AssertEqual 1, songwriter#tab#state#Get('carry').n
  call setline(2, 'B|--2-----|')
  AssertEqual {}, songwriter#tab#state#Get('carry')

Execute ('continuation': a value recorded without a cursor does not hold):
  call songwriter#tab#state#Set('carry', {'n': 1})
  AssertEqual {}, songwriter#tab#state#Get('carry')

Execute ('on-note' (the move state): while the cursor is on a note of a tab line in tablature mode, edits included):
  call cursor(1, 5)
  call songwriter#tab#state#Set('move', {})
  AssertNotEqual {}, songwriter#tab#state#Get('move')
  call setline(1, 'e|--4--5--|')
  AssertNotEqual {}, songwriter#tab#state#Get('move')
  call cursor(1, 4)
  AssertEqual {}, songwriter#tab#state#Get('move')
  call cursor(2, 5)
  AssertNotEqual {}, songwriter#tab#state#Get('move')
  let b:songwriter_tabmode = 0
  AssertEqual {}, songwriter#tab#state#Get('move')

Execute (OnNote: whether the cursor is on a note of a tab line, in tablature mode):
  call cursor(1, 5)
  Assert songwriter#tab#state#OnNote()
  call cursor(1, 4)
  Assert !songwriter#tab#state#OnNote()
  call cursor(1, 5)
  let b:songwriter_tabmode = 0
  Assert !songwriter#tab#state#OnNote()

Execute ('selection' (the visual object): while visual mode and the selection are as recorded):
  call cursor(1, 5)
  normal! v
  call cursor(1, 6)
  call songwriter#tab#state#Set('vobj', {'mode': 'v', 'sel': [1, 5, 1, 6]})
  AssertEqual [1, 5, 1, 6], songwriter#tab#state#Get('vobj').sel
  call setline(2, 'B|--2-----|')
  AssertEqual [1, 5, 1, 6], songwriter#tab#state#Get('vobj').sel
  call cursor(1, 5)
  AssertEqual {}, songwriter#tab#state#Get('vobj')
  call cursor(1, 6)
  execute "normal! \<Esc>"
  AssertEqual {}, songwriter#tab#state#Get('vobj')

Execute ('read-once' (`cia`'s word): through changes, until read):
  call songwriter#tab#state#Set('annotating', {'n': 1})
  call setline(1, 'e|--4--5--|')
  call cursor(2, 6)
  AssertEqual 1, songwriter#tab#state#Get('annotating').n
  AssertEqual {}, songwriter#tab#state#Get('annotating')

Execute (Clear: the state no longer holds):
  call songwriter#tab#state#Set('repeat', {'n': 1})
  call songwriter#tab#state#Clear('repeat')
  AssertEqual {}, songwriter#tab#state#Get('repeat')

Execute (Expire: drops a state recorded that no longer holds, and says so):
  call cursor(1, 5)
  call songwriter#tab#state#Set('move', {})
  AssertEqual 0, songwriter#tab#state#Expire('move')
  call cursor(1, 4)
  AssertEqual 1, songwriter#tab#state#Expire('move')
  Assert !exists('b:songwriter_move')
  AssertEqual 0, songwriter#tab#state#Expire('move')

Execute (A name without a lifetime is an error):
  AssertThrows call songwriter#tab#state#Set('x', {})
  AssertThrows call songwriter#tab#state#Get('x')
