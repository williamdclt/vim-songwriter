" 3.3: l/h move to the next/previous note column within the CURRENT BAR, then
" lint the moved bar. The motion is bar-local: l/h consider only the notes
" between the pipes that bound the cursor. 'l' behaves as 'a' (appends) when it
" is at the last note of the bar; 'h' is a no-op at the first note (no 'i'
" mirror). The just-opened 'a' slot is not linted away.

" --- 3.3.2 l at the last note of the bar appends a new-note slot ---

" Test: l at the last note of the bar appends a slot on every string (3.3.2)

Execute:
  filetype plugin on
  enew!
  call setline(1, 'e|--4--|')
  call append(1, 'b|--4--|')
  setfiletype songwriter
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  call SongwriterMoveColumn(1)
Then:
  AssertEqual 'e|--4----|', getline(1)
  AssertEqual 'b|--4----|', getline(2)
  AssertEqual 7, col('.')

" --- 3.3.4 h at the first note of the bar is a no-op (no mirror) ---

" Test: h at the first note of the bar does not move or append (3.3.4)

Execute:
  filetype plugin on
  enew!
  call setline(1, 'e|--4--|')
  call append(1, 'b|--4--|')
  setfiletype songwriter
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  call SongwriterMoveColumn(-1)
Then:
  AssertEqual 'e|--4--|', getline(1)
  AssertEqual 'b|--4--|', getline(2)
  AssertEqual 5, col('.')

" --- 3.3.3 l on a plain move lints the moved bar ---

" Test: l moves to the next in-bar note and trims trailing dashes (3.3.3)

Execute:
  filetype plugin on
  enew!
  call setline(1, 'e|--4---1---|')
  call append(1, 'b|--4---1--|')
  setfiletype songwriter
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  call SongwriterMoveColumn(1)
Then:
  AssertEqual 'e|--4---1--|', getline(1)
  AssertEqual 'b|--4---1--|', getline(2)
  AssertEqual 9, col('.')

" --- 3.3.3 h on a plain move lints the moved bar ---

" Test: h moves to the previous in-bar note and trims trailing dashes (3.3.3)

Execute:
  filetype plugin on
  enew!
  call setline(1, 'e|--4---1---|')
  call append(1, 'b|--4---1----|')
  setfiletype songwriter
  let b:songwriter_tabmode = 1
  call cursor(1, 9)
  call SongwriterMoveColumn(-1)
Then:
  AssertEqual 'e|--4---1--|', getline(1)
  AssertEqual 'b|--4---1--|', getline(2)
  AssertEqual 5, col('.')

" --- 3.3.2 l at the end of an earlier bar appends to THAT bar (bar-scoped) ---

" Test: l at the last note of the first bar appends to the first bar, not the next

Execute:
  filetype plugin on
  enew!
  call setline(1, 'e|--4--|--8--|')
  call append(1, 'b|--4--|--8--|')
  setfiletype songwriter
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  call SongwriterMoveColumn(1)
Then:
  AssertEqual 'e|--4----|--8--|', getline(1)
  AssertEqual 'b|--4----|--8--|', getline(2)
  AssertEqual 7, col('.')
