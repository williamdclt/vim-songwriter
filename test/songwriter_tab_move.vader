" 3.3: l/h move across note columns on the string(s) of the current bar.
" The search is confined to the current bar; `l` at the last note of the bar
" behaves as `a` and opens a new-note slot on every string (3.3.2); `h` at the
" first note of the bar is a no-op (no `i` mirror, 3.3.3). No lint runs on the
" move (spec item 4 is out of scope): leftover dashes after a slot stay until ||.

" --- 3.3.1 l/h move to the next/previous note column on any string ---

" Test: l moves to the next note column of another string in the same bar

Execute:
  filetype plugin on
  enew!
  call setline(1, 'e|----4----|')
  call append(1, 'B|---2-----|')
  setfiletype songwriter
  let b:songwriter_tabmode = 1
  call cursor(1, 3)
  call SongwriterMoveColumn(1)
Then:
  AssertEqual 6, col('.')

" Test: h moves to the previous note column of another string in the same bar

Execute:
  filetype plugin on
  enew!
  call setline(1, 'e|----4----|')
  call append(1, 'B|---2-----|')
  setfiletype songwriter
  let b:songwriter_tabmode = 1
  call cursor(1, 8)
  call SongwriterMoveColumn(-1)
Then:
  AssertEqual 7, col('.')

" --- 3.3.2 l at the last note of the bar behaves as `a` ---

" Test: l at the last note column opens a slot on every string

Execute:
  filetype plugin on
  enew!
  call setline(1, 'e|--4--|')
  call append(1, 'b|--4--|')
  setfiletype songwriter
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  call SongwriterMoveColumn(1)
Then:
  AssertEqual 'e|--4----|', getline(1)
  AssertEqual 'b|--4----|', getline(2)
  AssertEqual 7, col('.')

" Test: l in the middle of a bar moves, it does not append

Execute:
  filetype plugin on
  enew!
  call setline(1, 'e|--4--1--|')
  call append(1, 'b|--4--1--|')
  setfiletype songwriter
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  call SongwriterMoveColumn(1)
Then:
  AssertEqual 8, col('.')
  AssertEqual 'e|--4--1--|', getline(1)

" Test: l at the end of an EARLIER bar appends in that bar, it does not skip to
"       the next bar's note

Execute:
  filetype plugin on
  enew!
  call setline(1, 'e|--4--|--2--|')
  call append(1, 'b|------|------|')
  setfiletype songwriter
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  call SongwriterMoveColumn(1)
Then:
  AssertEqual 'e|--4----|--2--|', getline(1)
  AssertEqual 'b|--------|------|', getline(2)
  AssertEqual 7, col('.')

" --- 3.3.3 `h` at the first note column is a no-op ---

" Test: h at the first note column does not move or mirror-append

Execute:
  filetype plugin on
  enew!
  call setline(1, 'e|--4--|')
  call append(1, 'b|--4--|')
  setfiletype songwriter
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  call SongwriterMoveColumn(-1)
Then:
  AssertEqual 'e|--4--|', getline(1)
  AssertEqual 'b|--4--|', getline(2)
  AssertEqual 5, col('.')

" --- Empty-string edge: an empty string at the last note column gets a slot ---
" The last note may live on a neighbouring string; the empty string must still be
" widened, so a new note can be entered on it.

" Test: l on an empty line at the last note column opens a slot on every string

Execute:
  filetype plugin on
  enew!
  call setline(1, 'e|--4--|')
  call append(1, 'b|------|')
  setfiletype songwriter
  let b:songwriter_tabmode = 1
  call cursor(2, 5)
  call SongwriterMoveColumn(1)
Then:
  AssertEqual 'e|--4----|', getline(1)
  AssertEqual 'b|--------|', getline(2)
  AssertEqual 7, col('.')
