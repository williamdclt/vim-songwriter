" Spec [Tablature][[Editing]] 3.3 (songwriter#tab#MoveColumn): `l`/`h` move to the
" next/previous note column on any string; `l` on the last note of its bar opens
" a slot as `a` does (3.3.2); `h` never does, and is a no-op before the first
" note (3.3.3). Moving does not lint. Spec 5: `l` at the end of the tab appends
" a new bar with a slot in it.

Before:
  unlet! b:songwriter_tabmode b:songwriter_slot

" --- 3.3.1 l/h move to the next/previous note column on any string ---

Given songwriter (l moves to the next note column of another string in the same bar):
  e|----4----|
  B|---2-----|

Execute (l moves to the next note column of another string in the same bar):
  let b:songwriter_tabmode = 1
  call cursor(1, 3)
  call songwriter#tab#MoveColumn(1)
Then:
  AssertEqual 6, col('.')

Given songwriter (h moves to the previous note column of another string in the same bar):
  e|----4----|
  B|---2-----|

Execute (h moves to the previous note column of another string in the same bar):
  let b:songwriter_tabmode = 1
  call cursor(1, 8)
  call songwriter#tab#MoveColumn(-1)
Then:
  AssertEqual 7, col('.')

" --- 3.3.2 l at the last note of the bar behaves as `a` ---

Given songwriter (l at the last note column opens a slot on every string):
  e|--4--|
  b|--4--|

Execute (l at the last note column opens a slot on every string):
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  call songwriter#tab#MoveColumn(1)
Then:
  AssertEqual 7, col('.')
Expect:
  e|--4----|
  b|--4----|

Given songwriter (l in the middle of a bar moves, it does not append):
  e|--4--1--|
  b|--4--1--|

Execute (l in the middle of a bar moves, it does not append):
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  call songwriter#tab#MoveColumn(1)
Then:
  AssertEqual 8, col('.')
  AssertEqual 'e|--4--1--|', getline(1)

" Test: l at the end of an EARLIER bar appends in that bar, it does not skip to
"       the next bar's note

Given songwriter:
  e|--4--|--2--|
  b|------|------|

Execute:
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  call songwriter#tab#MoveColumn(1)
Then:
  AssertEqual 7, col('.')
Expect:
  e|--4----|--2--|
  b|-------|-----|

" --- 3.3.3 `h` at the first note column is a no-op ---

Given songwriter (h at the first note column does not move or mirror-append):
  e|--4--|
  b|--4--|

Execute (h at the first note column does not move or mirror-append):
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  call songwriter#tab#MoveColumn(-1)
Then:
  AssertEqual 5, col('.')
Expect:
  e|--4--|
  b|--4--|

" --- Empty-string edge: an empty string at the last note column gets a slot ---
" The last note may live on a neighbouring string; the empty string must still be
" widened, so a new note can be entered on it.

Given songwriter (l on an empty line at the last note column opens a slot on every string):
  e|--4--|
  b|------|

Execute (l on an empty line at the last note column opens a slot on every string):
  let b:songwriter_tabmode = 1
  call cursor(2, 5)
  call songwriter#tab#MoveColumn(1)
Then:
  AssertEqual 7, col('.')
Expect:
  e|--4----|
  b|-------|

" --- 5 l at the end of the tab creates a new bar with a slot in it ---

Given songwriter (5 l after the last note of the last bar appends a new bar):
  e|--3--5--|
  B|--------|

Execute (5 l after the last note of the last bar appends a new bar):
  let b:songwriter_tabmode = 1
  call cursor(2, 9)
  call songwriter#tab#MoveColumn(1)
Then:
  AssertEqual 14, col('.')
  AssertEqual 2, line('.')
Expect songwriter:
  e|--3--5--|-----|
  B|--------|-----|

Given songwriter (5 l on the closing pipe of the tab appends a new bar):
  e|--3--|

Execute (5 l on the closing pipe of the tab appends a new bar):
  let b:songwriter_tabmode = 1
  call cursor(1, 7)
  call songwriter#tab#MoveColumn(1)
Then:
  AssertEqual 11, col('.')
Expect songwriter:
  e|--3--|-----|

Given songwriter (5 the tab is linted before the new bar is added):
  e|--3-----|
  B|--5--|

Execute (5 the tab is linted before the new bar is added):
  let b:songwriter_tabmode = 1
  call cursor(1, 9)
  call songwriter#tab#MoveColumn(1)
Then:
  AssertEqual 11, col('.')
Expect songwriter:
  e|--3--|-----|
  B|--5--|-----|

Given songwriter (5 l on the last note opens a slot in its bar, a second l makes the new bar, a digit fills it):
  e|--3--5--|

Execute (5 l on the last note opens a slot in its bar, a second l makes the new bar, a digit fills it):
  let b:songwriter_tabmode = 1
  call cursor(1, 8)
  normal l
  AssertEqual 'e|--3--5----|', getline(1)
  normal l
  AssertEqual 'e|--3--5--|-----|', getline(1)
  AssertEqual 14, col('.')
  normal 7
Then:
  AssertEqual 14, col('.')
Expect songwriter:
  e|--3--5--|--7--|

Given songwriter (5 the new bar's slot abandoned is linted away, as an empty last bar (1.4)):
  e|--3--|

Execute (5 the new bar's slot abandoned is linted away, as an empty last bar (1.4)):
  let b:songwriter_tabmode = 1
  call cursor(1, 6)
  normal lh
Then:
  AssertEqual 5, col('.')
Expect songwriter:
  e|--3--|

Given songwriter (5 a bar that is not the last one never gets a new bar after it):
  e|--4--|--|

Execute (5 a bar that is not the last one never gets a new bar after it):
  let b:songwriter_tabmode = 1
  call cursor(1, 6)
  call songwriter#tab#MoveColumn(1)
Then:
  AssertEqual 7, col('.')
Expect songwriter:
  e|--4----|
