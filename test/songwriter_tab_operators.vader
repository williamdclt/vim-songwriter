" Spec [Tablature][[Editing]] 6.1-6.3, 6.6, 6.10-6.11: in tablature mode,
" operators act on whole time columns across every string. Typed end-to-end
" with `normal`.

Before:
  unlet! b:songwriter_tabmode b:songwriter_slot b:songwriter_typing
  let b:songwriter_tabmode = 1
  call setreg('"', [])

" --- 6.1 text objects with d ---

Given songwriter (6.1.1 dac removes the column and its gap on every string):
  e|--3--5--7--|
  B|-----5-----|

Execute (6.1.1 dac removes the column and its gap on every string):
  call cursor(1, 8)
  normal dac
Then:
  AssertEqual "\<C-V>3", getregtype('"')
  AssertEqual ['5--', '5--'], getreg('"', 1, 1)
Expect songwriter:
  e|--3--7--|
  B|--------|

Given songwriter (6.1.1 dic removes the note only, the gaps around it stay):
  e|--3--5--7--|

Execute (6.1.1 dic removes the note only, the gaps around it stay):
  call cursor(1, 8)
  normal dic
Expect songwriter:
  e|--3----7--|

Given songwriter (6.1.1 dac from another string, on a dash of that column):
  e|--3--5--7--|
  B|-----------|

Execute (6.1.1 dac from another string, on a dash of that column):
  call cursor(2, 9)
  normal dac
Expect songwriter:
  e|--3--7--|
  B|--------|

Given songwriter (6.1.3 d2ac removes two columns):
  e|--3--5--7--|

Execute (6.1.3 d2ac removes two columns):
  call cursor(1, 5)
  normal d2ac
Expect songwriter:
  e|--7--|

Given songwriter (6.1.2 da| removes the bar and one pipe):
  e|--3--|--5--|
  B|-----|--1--|

Execute (6.1.2 da| removes the bar and one pipe):
  call cursor(2, 4)
  normal da|
Expect songwriter:
  e|--5--|
  B|--1--|

Given songwriter (6.1.2 di| empties the bar):
  e|--3--5--|--7--|

Execute (6.1.2 di| empties the bar):
  call cursor(1, 8)
  normal di|
Expect songwriter:
  e|-----|--7--|

" --- 6.2 motions ---

Given songwriter (6.2 dw removes the note and its gap, block-wide):
  e|--3--5--7--|
  B|-----5-----|

Execute (6.2 dw removes the note and its gap, block-wide):
  call cursor(1, 8)
  normal dw
Expect songwriter:
  e|--3--7--|
  B|--------|

Given songwriter (6.2 dl removes the column; on the bar's last column it stops at the pipe):
  e|--3--5--|--7--|

Execute (6.2 dl removes the column; on the bar's last column it stops at the pipe):
  call cursor(1, 8)
  normal dl
Expect songwriter:
  e|--3--|--7--|

Given songwriter (6.2 dW deletes to the end of the bar):
  e|--3--5--7--|
  B|-----5-----|

Execute (6.2 dW deletes to the end of the bar):
  call cursor(1, 8)
  normal dW
Expect songwriter:
  e|--3--|
  B|-----|

Given songwriter (6.2 d$ deletes to the end of the tab and closes the bar):
  e|--3--5--|--7--|

Execute (6.2 d$ deletes to the end of the tab and closes the bar):
  call cursor(1, 8)
  normal d$
Expect songwriter:
  e|--3--|

Given songwriter (6.2 db removes the previous note and its gap):
  e|--3--5--7--|

Execute (6.2 db removes the previous note and its gap):
  call cursor(1, 11)
  normal db
Expect songwriter:
  e|--3--7--|

Given songwriter (6.2 a motion never cuts a two-digit note):
  e|--12--5--|

Execute (6.2 a motion never cuts a two-digit note):
  call cursor(1, 6)
  normal dw
Expect songwriter:
  e|--5--|

" --- 6.4 yank and registers ---

Given songwriter (6.4 yac yanks a blockwise column, buffer unchanged):
  e|--3--5--|
  B|-----5--|

Execute (6.4 yac yanks a blockwise column, buffer unchanged):
  call cursor(1, 8)
  normal yac
  AssertEqual "\<C-V>3", getregtype('"')
  AssertEqual ['5--', '5--'], getreg('"', 1, 1)
  AssertEqual 8, col('.')
Expect songwriter:
  e|--3--5--|
  B|-----5--|

Given songwriter (6.4 a named register):
  e|--3--5--|

Execute (6.4 a named register):
  call setreg('a', [])
  call cursor(1, 8)
  normal "aya|
  AssertEqual ['--3--5--|'], getreg('a', 1, 1)

" --- 6.3 line-wise ---

Given songwriter (6.3 dap deletes the whole tab):
  Intro

  e|--3--|
  B|--1--|

  end

Execute (6.3 dap deletes the whole tab):
  call cursor(4, 4)
  normal dap
  AssertEqual 'V', getregtype('"')
Expect songwriter:
  Intro

  end

Given songwriter (6.3 yip yanks the whole tab):
  e|--3--|
  B|--1--|

Execute (6.3 yip yanks the whole tab):
  call cursor(2, 4)
  normal yip
  AssertEqual ['e|--3--|', 'B|--1--|'], getreg('"', 1, 1)
  AssertEqual 'V', getregtype('"')

Given songwriter (6.3.1 cap clears every note and opens a slot; the emptied last bar goes (1.4)):
  e|--3--|--5--|
  B|-----|--1--|

Execute (6.3.1 cap clears every note and opens a slot; the emptied last bar goes (1.4)):
  call cursor(2, 4)
  normal cap
  AssertEqual 5, col('.')
  AssertEqual 1, songwriter#keys#InTabMode()
Expect songwriter:
  e|-----|
  B|-----|

" --- 6.6 change ---

Given songwriter (6.6 cac deletes the column and opens a slot in its place):
  e|--3--5--7--|

Execute (6.6 cac deletes the column and opens a slot in its place):
  call cursor(1, 8)
  normal cac
  AssertEqual 7, col('.')
Expect songwriter:
  e|--3---7--|

Given songwriter (6.6 cac then a digit enters the new note):
  e|--3--5--7--|

Execute (6.6 cac then a digit enters the new note):
  call cursor(1, 8)
  normal cac9
Expect songwriter:
  e|--3-9-7--|

Given songwriter (6.6 ci| restarts the bar from one empty slot):
  e|--3--5--|--7--|

Execute (6.6 ci| restarts the bar from one empty slot):
  call cursor(1, 5)
  normal ci|
  AssertEqual 5, col('.')
Expect songwriter:
  e|-----|--7--|

" --- 6.10 undo and repeat ---

Given songwriter (6.10 . repeats dac):
  e|--3--5--7--|

Execute (6.10 . repeats dac):
  call cursor(1, 5)
  normal dac.
Expect songwriter:
  e|--7--|

Given songwriter (6.10 one undo step, including the lint before and after):
  e|-----3--5--|

Execute (6.10 one undo step, including the lint before and after):
  call cursor(1, 11)
  normal dac
  AssertEqual 'e|--3--|', getline(1)
  normal u
Expect songwriter:
  e|-----3--5--|

" --- scope ---

Given songwriter (6 outside tablature mode, d is native and edits one line):
  e|--3--5--|
  B|--1--1--|

Execute (6 outside tablature mode, d is native and edits one line):
  let b:songwriter_tabmode = 0
  call cursor(1, 5)
  normal dl
Expect songwriter:
  e|----5--|
  B|--1--1--|

Given songwriter (6 off a tab line, d is native even in tablature mode):
  some prose here

Execute (6 off a tab line, d is native even in tablature mode):
  normal dw
Expect songwriter:
  prose here
