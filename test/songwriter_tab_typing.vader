" Spec [Tablature][[Editing]] 3.4.1.1-3.4.1.3: typing notes one after the
" other in the insert state, without `l` in between. `feedkeys` where undo
" steps matter (`normal` makes one undo step of all its keys).

Before:
  unlet! b:songwriter_tabmode b:songwriter_slot b:songwriter_typing b:songwriter_insert
  unlet! g:songwriter_max_fret
  let b:songwriter_tabmode = 1

After:
  unlet! g:songwriter_max_fret

" === 3.4.1.1 A digit that makes no fret opens the next slot ===

Given songwriter (3.4.1.1 a digit after a one-digit fret opens a slot after it):
  e|--4--|

Do (3.4.1.1 a digit after a one-digit fret opens a slot after it):
  f4a57

Expect songwriter (3.4.1.1 a digit after a one-digit fret opens a slot after it):
  e|--4-5-7--|

Given songwriter (3.4.1.1 the cursor is on the new note):
  e|--4--|

Execute (3.4.1.1 the cursor is on the new note):
  call cursor(1, 5)
  normal a57
Then:
  AssertEqual 9, col('.')
  Assert songwriter#tab#insert#Active()

Given songwriter (3.4.1.1 a run of notes):
  e|--4--|

Do (3.4.1.1 a run of notes):
  f4a5789

Expect songwriter (3.4.1.1 a run of notes):
  e|--4-5-7-8-9--|

Given songwriter (3.4.1.1 the run goes in before the next note):
  e|--4--9--|

Do (3.4.1.1 the run goes in before the next note):
  f4a57

Expect songwriter (3.4.1.1 the run goes in before the next note):
  e|--4-5-7-9--|

Given songwriter (3.4.1.1 a digit after 1 is appended):
  e|--4--|

Do (3.4.1.1 a digit after 1 is appended):
  f4a19

Expect songwriter (3.4.1.1 a digit after 1 is appended):
  e|--4-19--|

Given songwriter (3.4.1.1 a digit after 2 is appended up to 24):
  e|--4--|

Do (3.4.1.1 a digit after 2 is appended up to 24):
  f4a24

Expect songwriter (3.4.1.1 a digit after 2 is appended up to 24):
  e|--4-24--|

Given songwriter (3.4.1.1 2 then 5 are two notes):
  e|--4--|

Do (3.4.1.1 2 then 5 are two notes):
  f4a25

Expect songwriter (3.4.1.1 2 then 5 are two notes):
  e|--4-2-5--|

Given songwriter (3.4.1.1 0 then a digit are two notes):
  e|--4--|

Do (3.4.1.1 0 then a digit are two notes):
  f4a05

Expect songwriter (3.4.1.1 0 then a digit are two notes):
  e|--4-0-5--|

Given songwriter (3.4.1.1 a digit after a two-digit fret opens a slot):
  e|--4--|

Do (3.4.1.1 a digit after a two-digit fret opens a slot):
  f4a123

Expect songwriter (3.4.1.1 a digit after a two-digit fret opens a slot):
  e|--4-12-3--|

Given songwriter (3.4.1.1 g:songwriter_max_fret sets the highest fret):
  e|--4--|

Execute (3.4.1.1 g:songwriter_max_fret sets the highest fret):
  let g:songwriter_max_fret = 27
  call cursor(1, 5)
  normal a2527

Expect songwriter (3.4.1.1 g:songwriter_max_fret sets the highest fret):
  e|--4-25-27--|

Given songwriter (3.4.1.1 a digit after a muted note opens a slot):
  e|--4--|

Do (3.4.1.1 a digit after a muted note opens a slot):
  f4ax7

Expect songwriter (3.4.1.1 a digit after a muted note opens a slot):
  e|--4-x-7--|

Given songwriter (3.4.1.1 moving down builds a chord):
  e|--4--|
  B|--4--|

Do (3.4.1.1 moving down builds a chord):
  f4a5j7

Expect songwriter (3.4.1.1 moving down builds a chord):
  e|--4-5--|
  B|--4-7--|

Given songwriter (3.4.1.1 the next digit after a chord opens a slot after its column):
  e|--4--|
  B|--4--|

Do (3.4.1.1 the next digit after a chord opens a slot after its column):
  f4a5j79

Expect songwriter (3.4.1.1 the next digit after a chord opens a slot after its column):
  e|--4-5----|
  B|--4-7-9--|

Given songwriter (3.4.1.1 each note is its own undo step with its slot):
  e|--4--|

Execute (3.4.1.1 each note is its own undo step with its slot):
  let &undolevels = &undolevels
  call cursor(1, 5)
  call feedkeys("a57", 'xt')
  AssertEqual 'e|--4-5-7--|', getline(1)
  call feedkeys("u", 'xt')

Expect songwriter (3.4.1.1 each note is its own undo step with its slot):
  e|--4-5--|

Given songwriter (3.4.1.1 in the normal state digits are appended as before):
  e|--4--|

Do (3.4.1.1 in the normal state digits are appended as before):
  f457

Expect songwriter (3.4.1.1 in the normal state digits are appended as before):
  e|--57--|

" === 3.4.1.2 <Space> ===

Given songwriter (3.4.1.2 Space ends a note whose next digit would be appended):
  e|--4--|

Do (3.4.1.2 Space ends a note whose next digit would be appended):
  f4a1 5

Expect songwriter (3.4.1.2 Space ends a note whose next digit would be appended):
  e|--4-1-5--|

Given songwriter (3.4.1.2 Space on a slot closes it as l):
  e|--4--9--|

Execute (3.4.1.2 Space on a slot closes it as l):
  call cursor(1, 5)
  execute "normal a\<Space>"
Then:
  AssertEqual 'e|--4--9--|', getline(1)
  AssertEqual 8, col('.')

Given songwriter (3.4.1.2 Space stays native in the normal state):
  e|--4--|

Execute (3.4.1.2 Space stays native in the normal state):
  call cursor(1, 5)
  call feedkeys("\<Space>", 'xt')
Then:
  AssertEqual 'e|--4--|', getline(1)
  AssertEqual 6, col('.')

" === 3.4.1.3 Separators ===

Given songwriter (3.4.1.3 a separator and a digit after a note make a chain):
  e|--4--|

Do (3.4.1.3 a separator and a digit after a note make a chain):
  f4a5h7

Expect songwriter (3.4.1.3 a separator and a digit after a note make a chain):
  e|--4-5h7--|

Given songwriter (3.4.1.3 room is made on every string):
  e|--4--9--|
  B|--4--9--|

Do (3.4.1.3 room is made on every string):
  f4a5/7

Expect songwriter (3.4.1.3 room is made on every string):
  e|--4-5/7-9--|
  B|--4-----9--|

Given songwriter (3.4.1.3 a chain with two-digit frets):
  e|--4--|

Do (3.4.1.3 a chain with two-digit frets):
  f4a12p10

Expect songwriter (3.4.1.3 a chain with two-digit frets):
  e|--4-12p10--|

Given songwriter (3.4.1.3 every separator key):
  e|--4--|

Do (3.4.1.3 every separator key):
  f4a5h7p5b7r5t9s7/9~

Expect songwriter (3.4.1.3 every separator key):
  e|--4-5h7p5b7r5t9s7/9~--|

Given songwriter (3.4.1.3 the next digit after a chain opens a slot):
  e|--4--|

Do (3.4.1.3 the next digit after a chain opens a slot):
  f4a5h79

Expect songwriter (3.4.1.3 the next digit after a chain opens a slot):
  e|--4-5h7-9--|

Given songwriter (3.4.1.3 the note and its separators are one undo step with the slot):
  e|--4--|

Execute (3.4.1.3 the note and its separators are one undo step with the slot):
  let &undolevels = &undolevels
  call cursor(1, 5)
  call feedkeys("a5h7", 'xt')
  AssertEqual 'e|--4-5h7--|', getline(1)
  call feedkeys("u", 'xt')

Expect songwriter (3.4.1.3 the note and its separators are one undo step with the slot):
  e|--4--|

Given songwriter (3.4.1.3 h after moving is a motion):
  e|--4--|
  B|--4--|

Execute (3.4.1.3 h after moving is a motion):
  call cursor(1, 5)
  normal a5jh
Then:
  AssertEqual 'e|--4---5--|', getline(1)
  AssertEqual 2, line('.')

Given songwriter (3.4.1.3 h in the normal state is a motion):
  e|--4--9--|

Execute (3.4.1.3 h in the normal state is a motion):
  call cursor(1, 8)
  normal 5h
Then:
  AssertEqual 'e|--4--5--|', getline(1)
  AssertEqual 5, col('.')
