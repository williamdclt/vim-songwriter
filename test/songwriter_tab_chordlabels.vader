" --- [[Editing]] 10.10 `=<CR>` names the column ---

Given songwriter (10.10 =<CR> writes the column's name):
  e|--3--|
  B|--1--|
  G|--2--|
  D|--2--|
  A|--3--|
  E|-----|

Execute (10.10 =<CR> writes the column's name):
  call cursor(5, 5)
  let g:tab = getline(1, '$')
  redir => g:messages
  silent execute "normal =\<CR>"
  redir END
  Assert g:messages =~# '\[C6\] | Am7/C', g:messages
  AssertEqual ['    C6'] + g:tab, getline(1, '$')
  AssertEqual [6, 5], [line('.'), col('.')]

Execute (10.10 == cycles through the names, in one undo step):
  call cursor(5, 5)
  execute "normal =\<CR>"
  redir => g:messages
  silent normal ==
  redir END
  Assert g:messages =~# 'C6 | \[Am7/C\]', g:messages
  AssertEqual '    Am7/C', getline(1)
  normal ==
  AssertEqual '    C6', getline(1)
  normal u
  AssertEqual 'e|--3--|', getline(1)

Given songwriter (10.10 =<CR> replaces the chord label):
      Am
  e|--3--|
  B|--1--|
  G|--2--|
  D|--2--|
  A|--3--|
  E|-----|

Execute (10.10 =<CR> replaces the chord label):
  call cursor(6, 5)
  execute "normal =\<CR>"
  AssertEqual '    C6', getline(1)
  AssertEqual 7, line('$')

Given songwriter (10.10 refused when no chord fits):
  e|--0--|
  B|-----|
  G|-----|
  D|-----|
  A|-----|
  E|--0--|

Execute (10.10 refused when no chord fits):
  call cursor(1, 5)
  redir => g:messages
  silent execute "normal =\<CR>"
  redir END
  Assert g:messages =~# 'songwriter: one note, E', g:messages
  AssertEqual 'e|--0--|', getline(1)

" --- [[Annotations]] 10 `=` on a chord label ---

Given songwriter (A10.1 =<CR> on a label writes its voicing):
      Am
  e|-----|
  B|-----|
  G|-----|
  D|-----|
  A|-----|
  E|-----|

Execute (A10.1 =<CR> on a label writes its voicing):
  call cursor(1, 6)
  execute "normal =\<CR>"
  AssertEqual [1, 6], [line('.'), col('.')]

Expect songwriter (A10.1 =<CR> on a label writes its voicing):
      Am
  e|--0--|
  B|--1--|
  G|--2--|
  D|--2--|
  A|--0--|
  E|-----|

Execute (A10.1 the voicing lowest on the neck):
  for [chord, frets] in [['C', ['0', '1', '0', '2', '3', '-']], ['G', ['3', '0', '0', '0', '2', '3']],
        \ ['D', ['2', '3', '2', '0', '-', '-']], ['F', ['1', '1', '2', '3', '3', '1']]]
    %delete _
    call setline(1, ['    ' . chord] + map(['e', 'B', 'G', 'D', 'A', 'E'], 'v:val . "|-----|"'))
    call cursor(1, 5)
    execute "normal =\<CR>"
    AssertEqual frets, map(getline(2, 7), 'v:val[4]'), chord
  endfor

Given songwriter (A10.1 w and . go through a progression):
      Am       F
  e|--------------|
  B|--------------|
  G|--------------|
  D|--------------|
  A|--------------|
  E|--------------|

Execute (A10.1 w and . go through a progression):
  call cursor(1, 5)
  execute "normal =\<CR>"
  normal w.
  AssertEqual [1, 14], [line('.'), col('.')]

Expect songwriter (A10.1 w and . go through a progression):
      Am       F
  e|--0--------1--|
  B|--1--------1--|
  G|--2--------2--|
  D|--2--------3--|
  A|--0--------3--|
  E|-----------1--|

