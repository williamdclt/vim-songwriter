" Test: w skips over dashes, stops on next note

Execute:
  filetype plugin on
  enew!
  call setline(1, 'e|-----------4--|--1-----------|')
  setfiletype songwriter
  call cursor(1, 5)
  normal w
Then:
  AssertEqual 14, col('.')

" Test: w skips over dashes, stops on bar line

Execute:
  filetype plugin on
  enew!
  call setline(1, 'e|--4-----------|')
  setfiletype songwriter
  call cursor(1, 5)
  normal w
Then:
  AssertEqual 17, col('.')

" Test: b skips over dashes, stops on previous note

Execute:
  filetype plugin on
  enew!
  call setline(1, 'e|--4--2-----|')
  setfiletype songwriter
  call cursor(1, 8)
  normal b
Then:
  AssertEqual 5, col('.')

" Test: b skips over dashes, stops on bar line

Execute:
  filetype plugin on
  enew!
  call setline(1, 'e|--4-----------|')
  setfiletype songwriter
  call cursor(1, 12)
  normal b
Then:
  AssertEqual 5, col('.')

" Test: b stops on bar line before dashes

Execute:
  filetype plugin on
  enew!
  call setline(1, 'e|--4-----------|')
  setfiletype songwriter
  call cursor(1, 3)
  normal b
Then:
  AssertEqual 2, col('.')

" Test: w from string name stops on bar line

Execute:
  filetype plugin on
  enew!
  call setline(1, 'e|--4-----------|')
  setfiletype songwriter
  call cursor(1, 1)
  normal w
Then:
  AssertEqual 2, col('.')

" Test: L jumps to next bar line on tablature

Execute:
  filetype plugin on
  enew!
  call setline(1, 'e|--4-----------|--1-----------|')
  setfiletype songwriter
  call cursor(1, 5)
  normal L
Then:
  AssertEqual 17, col('.')

" Test: H jumps to previous bar line on tablature

Execute:
  filetype plugin on
  enew!
  call setline(1, 'e|--4-----------|--1-----------|')
  setfiletype songwriter
  call cursor(1, 20)
  normal H
Then:
  AssertEqual 17, col('.')

" Test: L from string name jumps to first bar line

Execute:
  filetype plugin on
  enew!
  call setline(1, 'e|--4-----------|')
  setfiletype songwriter
  call cursor(1, 1)
  normal L
Then:
  AssertEqual 2, col('.')

" Test: H from after first bar line jumps back to it

Execute:
  filetype plugin on
  enew!
  call setline(1, 'e|--4-----------|')
  setfiletype songwriter
  call cursor(1, 5)
  normal H
Then:
  AssertEqual 2, col('.')

" Test: w on prose line behaves normally

Execute:
  filetype plugin on
  enew!
  call setline(1, 'I walk a lonely road')
  setfiletype songwriter
  call cursor(1, 1)
  normal w
Then:
  AssertEqual 3, col('.')

" Test: b on prose line behaves normally (from 'lonely' back to 'a')

Execute:
  filetype plugin on
  enew!
  call setline(1, 'I walk a lonely road')
  setfiletype songwriter
  call cursor(1, 10)
  normal b
Then:
  AssertEqual 8, col('.')
