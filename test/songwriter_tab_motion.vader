
Before:
  unlet! b:songwriter_tabmode

Given songwriter (w skips over dashes, stops on next note):
  e|-----------4--|--1-----------|

Execute (w skips over dashes, stops on next note):
  call cursor(1, 5)
  normal w
Then:
  AssertEqual 14, col('.')

Given songwriter (w skips over dashes, stops on bar line):
  e|--4-----------|

Execute (w skips over dashes, stops on bar line):
  call cursor(1, 5)
  normal w
Then:
  AssertEqual 17, col('.')

Given songwriter (b skips over dashes, stops on previous note):
  e|--4--2-----|

Execute (b skips over dashes, stops on previous note):
  call cursor(1, 8)
  normal b
Then:
  AssertEqual 5, col('.')

Given songwriter (b skips over dashes, stops on bar line):
  e|--4-----------|

Execute (b skips over dashes, stops on bar line):
  call cursor(1, 12)
  normal b
Then:
  AssertEqual 5, col('.')

Given songwriter (b stops on bar line before dashes):
  e|--4-----------|

Execute (b stops on bar line before dashes):
  call cursor(1, 3)
  normal b
Then:
  AssertEqual 2, col('.')

Given songwriter (w from string name stops on bar line):
  e|--4-----------|

Execute (w from string name stops on bar line):
  call cursor(1, 1)
  normal w
Then:
  AssertEqual 2, col('.')

Given songwriter (L jumps to next bar line on tablature):
  e|--4-----------|--1-----------|

Execute (L jumps to next bar line on tablature):
  call cursor(1, 5)
  normal L
Then:
  AssertEqual 17, col('.')

Given songwriter (H jumps to previous bar line on tablature):
  e|--4-----------|--1-----------|

Execute (H jumps to previous bar line on tablature):
  call cursor(1, 20)
  normal H
Then:
  AssertEqual 17, col('.')

Given songwriter (L from string name jumps to first bar line):
  e|--4-----------|

Execute (L from string name jumps to first bar line):
  call cursor(1, 1)
  normal L
Then:
  AssertEqual 2, col('.')

Given songwriter (H from after first bar line jumps back to it):
  e|--4-----------|

Execute (H from after first bar line jumps back to it):
  call cursor(1, 5)
  normal H
Then:
  AssertEqual 2, col('.')

Given songwriter (w on prose line behaves normally):
  I walk a lonely road

Execute (w on prose line behaves normally):
  call cursor(1, 1)
  normal w
Then:
  AssertEqual 3, col('.')

Given songwriter (b on prose line behaves normally (from 'lonely' back to 'a')):
  I walk a lonely road

Execute (b on prose line behaves normally (from 'lonely' back to 'a')):
  call cursor(1, 10)
  normal b
Then:
  AssertEqual 8, col('.')
