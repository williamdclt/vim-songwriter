" Spec [Tablature][[Editing]] 3.7: `<leader><leader>k` / `<leader><leader>j`
" copy the note onto the string above / below, the cursor on the copy, which
" is then carried (3.6). The leader is the default `\`. `feedkeys` where undo
" steps matter (`normal` makes one undo step of all its keys).

Before:
  unlet! b:songwriter_tabmode b:songwriter_slot b:songwriter_typing b:songwriter_insert b:songwriter_carry b:songwriter_moving
  let b:songwriter_tabmode = 1

" === Duplicating ===

Given songwriter (3.7 <leader><leader>k copies the note onto the string above, the cursor following it):
  e|-----------|
  B|--3--5--7--|

Execute (3.7 <leader><leader>k copies the note onto the string above, the cursor following it):
  call cursor(2, 8)
  execute "normal \\\\k"
Then:
  AssertEqual [1, 8], [line('.'), col('.')]
  Assert !songwriter#tab#insert#Active()
  AssertEqual '', songwriter#keys#Mode()

Expect songwriter (3.7 <leader><leader>k copies the note onto the string above, the cursor following it):
  e|-----5-----|
  B|--3--5--7--|

Given songwriter (3.7 <leader><leader>j copies the note onto the string below):
  e|--3--5--7--|
  B|-----------|

Execute (3.7 <leader><leader>j copies the note onto the string below):
  call cursor(1, 8)
  execute "normal \\\\j"
Then:
  AssertEqual [2, 8], [line('.'), col('.')]

Expect songwriter (3.7 <leader><leader>j copies the note onto the string below):
  e|--3--5--7--|
  B|-----5-----|

Given songwriter (3.7 a two-digit fret is copied whole, with the separator that belongs to it):
  e|------|
  B|--12~-|

Execute (3.7 a two-digit fret is copied whole, with the separator that belongs to it):
  call cursor(2, 6)
  execute "normal \\\\k"
Then:
  AssertEqual [1, 6], [line('.'), col('.')]

Expect songwriter (3.7 a two-digit fret is copied whole, with the separator that belongs to it):
  e|--12~--|
  B|--12~--|

Given songwriter (3.7 nothing happens on the top string, or off a note):
  e|--3--|
  B|-----|

Execute (3.7 nothing happens on the top string, or off a note):
  call cursor(1, 5)
  execute "normal \\\\k"
  call cursor(1, 4)
  execute "normal \\\\j"
Then:
  AssertEqual [1, 4], [line('.'), col('.')]

Expect songwriter (3.7 nothing happens on the top string, or off a note):
  e|--3--|
  B|-----|

Given songwriter (3.7 <leader>k then carries the copy, the original staying):
  e|-----|
  B|-----|
  G|--5--|

Execute (3.7 <leader>k then carries the copy, the original staying):
  call cursor(3, 5)
  execute "normal \\\\k\\k"
Then:
  AssertEqual [1, 5], [line('.'), col('.')]

Expect songwriter (3.7 <leader>k then carries the copy, the original staying):
  e|--5--|
  B|-----|
  G|--5--|

Given songwriter (3.7 the copy carried back onto the original is gone):
  e|-----|
  B|--5--|

Execute (3.7 the copy carried back onto the original is gone):
  call cursor(2, 5)
  execute "normal \\\\k\\j"
Then:
  AssertEqual [2, 5], [line('.'), col('.')]

Expect songwriter (3.7 the copy carried back onto the original is gone):
  e|-----|
  B|--5--|

Given songwriter (3.7 the copy replaces a note on its way, which comes back once it moves on):
  e|-----|
  B|--3--|
  G|--5--|

Execute (3.7 the copy replaces a note on its way, which comes back once it moves on):
  call cursor(3, 5)
  execute "normal \\\\k"
  AssertEqual ['e|-----|', 'B|--5--|', 'G|--5--|'], getline(1, '$')
  execute "normal \\k"

Expect songwriter (3.7 the copy replaces a note on its way, which comes back once it moves on):
  e|--5--|
  B|--3--|
  G|--5--|

Given songwriter (3.7 the copy and its run are one undo step):
  e|-----|
  B|-----|
  G|--5--|

Execute (3.7 the copy and its run are one undo step):
  call cursor(3, 5)
  call feedkeys("\\\\k", 'xt')
  call feedkeys("\\k", 'xt')
  call feedkeys('u', 'xt')

Expect songwriter (3.7 the copy and its run are one undo step):
  e|-----|
  B|-----|
  G|--5--|

" === `]` / `[` change frets (spec 11) ===

Given songwriter (] is <C-A> on a fret):
  e|--5--7--|

Execute (] is <C-A> on a fret):
  call cursor(1, 5)
  execute "normal ]"

Expect songwriter (] is <C-A> on a fret):
  e|--6--7--|

Given songwriter ([ is <C-X> on a fret):
  e|--5--7--|

Execute ([ is <C-X> on a fret):
  call cursor(1, 5)
  execute "normal ["

Expect songwriter ([ is <C-X> on a fret):
  e|--4--7--|

Given songwriter (] and [ transpose a chord):
  Am      F

Execute (] and [ transpose a chord):
  call cursor(1, 1)
  execute "normal ]]"
  call cursor(1, 9)
  execute "normal ["

Expect songwriter (] and [ transpose a chord):
  Bm      E

Given songwriter (] in visual mode changes every selected fret):
  e|--5--7--|

Execute (] in visual mode changes every selected fret):
  call cursor(1, 5)
  execute "normal v$]"

Expect songwriter (] in visual mode changes every selected fret):
  e|--6--8--|
