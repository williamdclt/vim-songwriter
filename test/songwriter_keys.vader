" Key dispatch (autoload/songwriter/keys.vim) and ftplugin setup/teardown.

Before:
  enew!

Execute (Dispatch: a context key off a tab line falls back to its default):
  call setline(1, 'some prose')
  setfiletype songwriter
  let b:songwriter_tabmode = 1
  AssertEqual 'l', songwriter#keys#Dispatch('l')
  AssertEqual "\<Esc>", songwriter#keys#Dispatch('<Esc>')

Execute (Dispatch: tablature mode wins over the plain tab-line action):
  call setline(1, 'e|--4--|')
  setfiletype songwriter
  let b:songwriter_tabmode = 0
  AssertEqual "\<Cmd>call songwriter#keys#TabWord(1)\<CR>", songwriter#keys#Dispatch('w')
  let b:songwriter_tabmode = 1
  AssertEqual "\<Cmd>call songwriter#tab#MoveWord(\"w\")\<CR>", songwriter#keys#Dispatch('w')

Execute (Opening a songwriter buffer turns tablature mode on (spec [Tablature][[Editing]] 3)):
  setfiletype songwriter
  AssertEqual 1, songwriter#keys#InTabMode()

Execute (Leaving the filetype removes the tablature mode flag):
  setfiletype songwriter
  set filetype=text
  Assert !exists('b:songwriter_tabmode')

Execute (Leaving the filetype removes every buffer map and restores options):
  setfiletype songwriter
  Assert !empty(maparg('_', 'n'))
  set filetype=text
  AssertEqual [], filter(['_', '||', '<C-A>', 'w', '5', 'W', 'B', 'E', 'L', 'H', '<Esc>'], '!empty(maparg(v:val, "n"))')
  AssertEqual '', maparg('W', 'o') . maparg('W', 'x')
  AssertEqual '', maparg('<C-A>', 'x') . maparg('<C-X>', 'x')
  AssertEqual 1, &l:wrap

Execute (Every context key of every mode is mapped, and unmapped on leaving the filetype):
  setfiletype songwriter
  let keys = []
  for m in ['n', 'o', 'x']
    call extend(keys, map(songwriter#keys#ContextKeys(m), '[m, substitute(v:val, "|", "<Bar>", "g")]'))
  endfor
  AssertEqual [], filter(copy(keys), 'empty(maparg(v:val[1], v:val[0]))')
  set filetype=text
  AssertEqual [], filter(copy(keys), '!empty(maparg(v:val[1], v:val[0]))')
