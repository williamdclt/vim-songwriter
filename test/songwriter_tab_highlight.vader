" Spec [Tablature][[Rendering]] 4: in tablature mode, the time column under
" the cursor is highlighted on every string of the tab, notes or dashes, as
" wide as its widest note. Highlighting only: the file is unchanged.

Before:
  unlet! b:songwriter_tabmode b:songwriter_slot b:songwriter_typing b:songwriter_mode
  let b:songwriter_tabmode = 1
  call songwriter#tab#highlight#Clear()

After:
  call songwriter#tab#highlight#Clear()

Execute (Rendering 4 pure: the column on every string, notes or not, as wide as its widest note):
  let b = songwriter#tab#model#Parse(3, ['e|--0--3--|', 'B|--1-----|', 'G|-----12-|'])
  AssertEqual [[3, 5, 1], [4, 5, 1], [5, 5, 1]], songwriter#tab#highlight#Positions(b, 0, 5)
  AssertEqual [[3, 8, 2], [4, 8, 2], [5, 8, 2]], songwriter#tab#highlight#Positions(b, 2, 9)
  AssertEqual [[3, 8, 2], [4, 8, 2], [5, 8, 2]], songwriter#tab#highlight#Positions(b, 1, 8)
  AssertEqual [], songwriter#tab#highlight#Positions(b, 0, 6)

Given songwriter (Rendering 4 the column under the cursor is highlighted):
  e|--0--3--|
  B|--1-----|

Execute (Rendering 4 the column under the cursor is highlighted):
  call cursor(2, 5)
  call songwriter#tab#highlight#Update()
  let m = filter(getmatches(), 'v:val.group ==# "songwriterTimeColumn"')
  AssertEqual 1, len(m)
  AssertEqual [1, 5, 1], m[0].pos1
  AssertEqual [2, 5, 1], m[0].pos2

Execute (Rendering 4 moving updates the highlight, a dash with no column clears it):
  call cursor(1, 8)
  call songwriter#tab#highlight#Update()
  let m = filter(getmatches(), 'v:val.group ==# "songwriterTimeColumn"')
  AssertEqual [[1, 8, 1], [2, 8, 1]], [m[0].pos1, m[0].pos2]
  call cursor(1, 6)
  call songwriter#tab#highlight#Update()
  AssertEqual [], filter(getmatches(), 'v:val.group ==# "songwriterTimeColumn"')

Execute (Rendering 4 nothing is highlighted outside tablature mode):
  let b:songwriter_tabmode = 0
  call cursor(1, 5)
  call songwriter#tab#highlight#Update()
  AssertEqual [], filter(getmatches(), 'v:val.group ==# "songwriterTimeColumn"')

Given songwriter (Rendering 4 nothing is highlighted off a tab line):
  some prose 12

Execute (Rendering 4 nothing is highlighted off a tab line):
  call cursor(1, 12)
  call songwriter#tab#highlight#Update()
  AssertEqual [], filter(getmatches(), 'v:val.group ==# "songwriterTimeColumn"')

Execute (Rendering 4 the highlight follows the cursor through autocommands):
  Assert exists('#songwriter_column#CursorMoved#<buffer>')
  Assert exists('#songwriter_column#WinLeave#<buffer>')
  AssertEqual 'CursorColumn', synIDattr(synIDtrans(hlID('songwriterTimeColumn')), 'name')

Given songwriter (Annotations 7 a tab with annotations):
      Am
  e|--0--3--|
  B|--1-----|

Execute (Annotations 7 the highlight extends over the annotation lines):
  call cursor(2, 5)
  call songwriter#tab#highlight#Update()
  let m = filter(getmatches(), 'v:val.group ==# "songwriterTimeColumn"')
  AssertEqual [[1, 5, 1], [2, 5, 1], [3, 5, 1]], [m[0].pos1, m[0].pos2, m[0].pos3]

" Spec [Tablature][[Editing]] 3.8.5: in the move state, the time column band
" takes another color (songwriterMoveColumn).

Given songwriter (3.8.5 a tab with a two-digit note):
  e|--0--12--|
  B|--1------|

Execute (3.8.5 entering the move state recolors the band, leaving it restores it):
  call cursor(1, 9)
  call songwriter#tab#highlight#Update()
  AssertEqual [], filter(getmatches(), 'v:val.group ==# "songwriterMoveColumn"')
  normal m
  AssertEqual [], filter(getmatches(), 'v:val.group ==# "songwriterTimeColumn"')
  let m = filter(getmatches(), 'v:val.group ==# "songwriterMoveColumn"')
  AssertEqual 1, len(m)
  AssertEqual [[1, 8, 2], [2, 8, 2]], [m[0].pos1, m[0].pos2]
  normal m
  AssertEqual [], filter(getmatches(), 'v:val.group ==# "songwriterMoveColumn"')
  AssertEqual 1, len(filter(getmatches(), 'v:val.group ==# "songwriterTimeColumn"'))

Execute (3.8.5 the band follows the cursor in the move state):
  call cursor(1, 5)
  normal m
  call cursor(2, 5)
  call songwriter#tab#highlight#Update()
  let m = filter(getmatches(), 'v:val.group ==# "songwriterMoveColumn"')
  AssertEqual [[1, 5, 1], [2, 5, 1]], [m[0].pos1, m[0].pos2]
  call songwriter#tab#mode#Enter('normal')
  AssertEqual [], filter(getmatches(), 'v:val.group ==# "songwriterMoveColumn"')

Execute (3.8.5 the cursor leaving the notes ends it):
  call cursor(1, 5)
  normal m
  call cursor(1, 6)
  call songwriter#tab#highlight#Update()
  AssertEqual [], filter(getmatches(), 'v:val.group ==# "songwriterMoveColumn"')

Execute (3.8.5 the group has a default):
  AssertEqual 'Search', synIDattr(synIDtrans(hlID('songwriterMoveColumn')), 'name')
