" Spec [Tablature][[Annotations]] 8: <leader>a starts typing an annotation
" above the cursor's column.

Before:
  unlet! b:songwriter_tabmode b:songwriter_slot b:songwriter_typing b:songwriter_insert
  let b:songwriter_tabmode = 1

Given songwriter (a tab with no annotation):
  e|--0--3--|

Execute (8 with no annotation line, one is opened, the cursor at its column):
  call cursor(1, 8)
  execute "normal \\aC\<Esc>"

Expect songwriter:
         C
  e|--0--3--|

Given songwriter (a tab with no annotation):
  e|--0--3--|

Execute (8 a new line left empty is deleted):
  call cursor(1, 8)
  execute "normal \\a\<Esc>"
  AssertEqual 1, line('$')

Expect songwriter:
  e|--0--3--|

Given songwriter (a tab with no annotation):
  e|--0--3--|

Execute (8 the line and what is typed on it are one undo step):
  call cursor(1, 8)
  execute "normal \\aC\<Esc>u"

Expect songwriter:
  e|--0--3--|

Given songwriter (a short annotation line):
      Am
  e|--0--3--|

Execute (8 past the end of the line, spaces are added up to the column):
  call cursor(2, 8)
  execute "normal \\aC\<Esc>"

Expect songwriter:
      Am C
  e|--0--3--|

Given songwriter (a short annotation line):
      Am
  e|--0--3--|

Execute (8 spaces left at the end of the line are removed):
  call cursor(2, 8)
  execute "normal \\a\<Esc>"

Expect songwriter:
      Am
  e|--0--3--|

Given songwriter (an annotation line with words after the column):
      Am    G
  e|--0--3--0--|

Execute (8 inside the line, typing replaces its spaces, the words after it stay):
  call cursor(2, 8)
  execute "normal \\aC\<Esc>"

Expect songwriter:
      Am C  G
  e|--0--3--0--|

Given songwriter (annotations above the strings):
      PM--|
      Am
  e|--0--3--|
  B|--1-----|

Execute (8 from any string, on the line right above the strings, never in the first two columns):
  call cursor(4, 1)
  execute "normal \\aX\<Esc>"

Expect songwriter:
      PM--|
    X Am
  e|--0--3--|
  B|--1-----|

Given songwriter (a tab with no annotation):
  e|--0--3--|

Execute (8 it works with tablature mode off):
  let b:songwriter_tabmode = 0
  call cursor(1, 5)
  execute "normal \\aAm\<Esc>"

Expect songwriter:
      Am
  e|--0--3--|

Given songwriter (prose):
  some prose

Execute (8 off a tab line, nothing happens):
  call cursor(1, 3)
  execute "normal \\a"

Expect songwriter:
  some prose
