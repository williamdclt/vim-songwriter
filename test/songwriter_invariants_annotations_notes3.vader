  let g:inv_known += [
        \ 'moved c: two-digit frets, 1:9, daw', 'moved d: two-digit frets, 1:9, daw', 'moved e: two-digit frets, 1:9, daw', 'moved d: two-digit frets, 2:11, daw',
        \ 'moved e: two-digit frets, 2:11, daw', 'moved d: two-digit frets, 3:11, sk', 'moved e: two-digit frets, 3:11, sk', 'moved e: separators, 1:18, daw',
        \ 'moved f: separators, 1:18, daw', 'moved c: separators, 2:8, daw', 'moved d: separators, 2:8, daw', 'moved e: separators, 2:8, daw',
        \ 'moved f: separators, 2:8, daw']

