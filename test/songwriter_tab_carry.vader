" Spec [Tablature][[Editing]] 3.6: `<leader>k` / `<leader>j` carry the note
" under the cursor to the string above / below, keeping its fret (as `sk` /
" `sj`, 7). The leader is the default `\`. `feedkeys` where undo steps matter
" (`normal` makes one undo step of all its keys).

Before:
  unlet! b:songwriter_tabmode b:songwriter_slot b:songwriter_typing b:songwriter_insert b:songwriter_move b:songwriter_carry b:songwriter_repeat
  let b:songwriter_tabmode = 1

" === Carrying ===

Given songwriter (3.6 <leader>k carries the note up, the cursor with it):
  e|--------|
  B|--5--3--|

Execute (3.6 <leader>k carries the note up, the cursor with it):
  call cursor(2, 5)
  execute "normal \\k"
Then:
  AssertEqual [1, 5], [line('.'), col('.')]
  AssertEqual '', songwriter#keys#Mode()

Expect songwriter (3.6 <leader>k carries the note up, the cursor with it):
  e|--5-----|
  B|-----3--|

Given songwriter (3.6 <leader>j carries the note down, keeping its digit under the cursor):
  e|--12--|
  B|------|

Execute (3.6 <leader>j carries the note down, keeping its digit under the cursor):
  call cursor(1, 6)
  execute "normal \\j"
Then:
  AssertEqual [2, 6], [line('.'), col('.')]

Expect songwriter (3.6 <leader>j carries the note down, keeping its digit under the cursor):
  e|------|
  B|--12--|

Given songwriter (3.6.1 a separator joining the note to another stays):
  e|--5h7--|
  B|-------|

Execute (3.6.1 a separator joining the note to another stays):
  call cursor(1, 7)
  execute "normal \\j"

Expect songwriter (3.6.1 a separator joining the note to another stays):
  e|--5h---|
  B|----7--|

Given songwriter (3.6.1 a note carried onto is replaced, and comes back when the carried note moves on):
  e|-----|
  B|--3--|
  G|--5--|

Execute (3.6.1 a note carried onto is replaced, and comes back when the carried note moves on):
  call cursor(3, 5)
  execute "normal \\k"
  AssertEqual ['e|-----|', 'B|--5--|', 'G|-----|'], getline(1, '$')
  execute "normal \\k"
Then:
  AssertEqual [1, 5], [line('.'), col('.')]

Expect songwriter (3.6.1 a note carried onto is replaced, and comes back when the carried note moves on):
  e|--5--|
  B|--3--|
  G|-----|

Given songwriter (3.6.2 carried back where it started, the tab is exactly as it was):
  e|--3-----|
  B|-----5--|
  G|--7--5--|

Execute (3.6.2 carried back where it started, the tab is exactly as it was):
  call cursor(3, 8)
  execute "normal \\k\\k\\j\\j"
Then:
  AssertEqual [3, 8], [line('.'), col('.')]

Expect songwriter (3.6.2 carried back where it started, the tab is exactly as it was):
  e|--3-----|
  B|-----5--|
  G|--7--5--|

Given songwriter (3.6.2 a run of carries is one undo step):
  e|-----|
  B|--3--|
  G|--5--|

Execute (3.6.2 a run of carries is one undo step):
  call cursor(3, 5)
  call feedkeys("\\k", 'xt')
  call feedkeys("\\k", 'xt')
  call feedkeys('u', 'xt')

Expect songwriter (3.6.2 a run of carries is one undo step):
  e|-----|
  B|--3--|
  G|--5--|

Given songwriter (3.6.2 another change ends the run: the note replaced is gone):
  e|-----|
  B|--3--|
  G|--5--|

Execute (3.6.2 another change ends the run: the note replaced is gone):
  call cursor(3, 5)
  execute "normal \\k]\\k"

Expect songwriter (3.6.2 another change ends the run: the note replaced is gone):
  e|--6--|
  B|-----|
  G|-----|

Given songwriter (3.6.2 the tab is linted after each carry):
  e|-----------|
  B|--5--------|

Execute (3.6.2 the tab is linted after each carry):
  call cursor(2, 5)
  execute "normal \\k"

Expect songwriter (3.6.2 the tab is linted after each carry):
  e|--5--|
  B|-----|

Given songwriter (3.6.3 no string that way: refused, the tab unchanged):
  e|--3--|
  B|--5--|

Execute (3.6.3 no string that way: refused, the tab unchanged):
  call cursor(1, 5)
  execute "normal \\k"
  call cursor(1, 4)
  execute "normal \\j"

Expect songwriter (3.6.3 no string that way: refused, the tab unchanged):
  e|--3--|
  B|--5--|

Given songwriter (3.6 . repeats the carry, in its run):
  e|-----|
  B|--3--|
  G|--5--|

Execute (3.6 . repeats the carry, in its run):
  call cursor(3, 5)
  call feedkeys("\\k", 'xt')
  call feedkeys('.', 'xt')
  AssertEqual ['e|--5--|', 'B|--3--|', 'G|-----|'], getline(1, '$')
  call feedkeys('u', 'xt')

Expect songwriter (3.6 . repeats the carry, in its run):
  e|-----|
  B|--3--|
  G|--5--|

Given songwriter (3.6 a carry closes an open slot first):
  e|--3--5--|
  B|--------|

Execute (3.6 a carry closes an open slot first):
  call cursor(1, 5)
  execute "normal a"
  call cursor(1, 5)
  execute "normal \\j"
Then:
  Assert songwriter#tab#mode#Current() !=# 'insert'

Expect songwriter (3.6 a carry closes an open slot first):
  e|-----5--|
  B|--3-----|

" === Visual mode (3.6.4) ===

Given songwriter (3.6.4 visual <leader>k carries every selected note, the selection with them):
  e|--------|
  B|--5--3--|
  G|--7-----|

Execute (3.6.4 visual <leader>k carries every selected note, the selection with them):
  call cursor(2, 5)
  execute "normal \<C-V>j\\k\<Esc>"
Then:
  AssertEqual [1, 5], getpos("'<")[1:2]
  AssertEqual [2, 5], getpos("'>")[1:2]

Expect songwriter (3.6.4 visual <leader>k carries every selected note, the selection with them):
  e|--5-----|
  B|--7--3--|
  G|--------|

Given songwriter (3.6.4 visual <leader>j carries the notes a charwise selection touches):
  e|--5--3--|
  B|--------|

Execute (3.6.4 visual <leader>j carries the notes a charwise selection touches):
  call cursor(1, 4)
  execute "normal vl\\j\<Esc>"
Then:
  AssertEqual [2, 4], getpos("'<")[1:2]
  AssertEqual [2, 5], getpos("'>")[1:2]

Expect songwriter (3.6.4 visual <leader>j carries the notes a charwise selection touches):
  e|-----3--|
  B|--5-----|

Given songwriter (3.6.4 pressed again, the carry goes on in its run: a note replaced comes back):
  e|-----|
  B|--3--|
  G|--5--|

Execute (3.6.4 pressed again, the carry goes on in its run: a note replaced comes back):
  call cursor(3, 5)
  execute "normal v\\k\\k"

Expect songwriter (3.6.4 pressed again, the carry goes on in its run: a note replaced comes back):
  e|--5--|
  B|--3--|
  G|-----|

Given songwriter (3.6.4 refused when a selected note has no string that way):
  e|--3--|
  B|--5--|

Execute (3.6.4 refused when a selected note has no string that way):
  call cursor(1, 5)
  execute "normal \<C-V>j\\k\<Esc>"
Then:
  AssertEqual [1, 5], getpos("'<")[1:2]
  AssertEqual [2, 5], getpos("'>")[1:2]

Expect songwriter (3.6.4 refused when a selected note has no string that way):
  e|--3--|
  B|--5--|

" === Changing the fret in the run (3.6.5) ===

Given songwriter (3.6.5 <leader>h / <leader>l move the note a fret down / up):
  e|--5--7--|

Execute (3.6.5 <leader>h / <leader>l move the note a fret down / up):
  call cursor(1, 5)
  execute "normal \\l\\l"
  call cursor(1, 8)
  execute "normal \\h"

Expect songwriter (3.6.5 <leader>h / <leader>l move the note a fret down / up):
  e|--7--6--|

Given songwriter (3.6.5 <leader>l is part of the run: the note replaced still comes back):
  e|-----|
  B|--3--|
  G|--5--|

Execute (3.6.5 <leader>l is part of the run: the note replaced still comes back):
  call cursor(3, 5)
  execute "normal \\k\\l"
  AssertEqual ['e|-----|', 'B|--6--|', 'G|-----|'], getline(1, '$')
  execute "normal \\k"

Expect songwriter (3.6.5 <leader>l is part of the run: the note replaced still comes back):
  e|--6--|
  B|--3--|
  G|-----|

Given songwriter (3.6.5 back where it started with its fret, the tab is as it was):
  e|--9--7--|

Execute (3.6.5 back where it started with its fret, the tab is as it was):
  call cursor(1, 5)
  execute "normal \\l"
  AssertEqual ['e|--10-7--|'], getline(1, '$')
  execute "normal \\h"

Expect songwriter (3.6.5 back where it started with its fret, the tab is as it was):
  e|--9--7--|

Given songwriter (3.6.5 a fret out of range, or no fret, is refused):
  e|--0--x--|

Execute (3.6.5 a fret out of range, or no fret, is refused):
  call cursor(1, 5)
  execute "normal \\h"
  call cursor(1, 8)
  execute "normal \\l"

Expect songwriter (3.6.5 a fret out of range, or no fret, is refused):
  e|--0--x--|
