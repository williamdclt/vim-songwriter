" Spec [Tablature -> Editing] 3.4 (numbers enter a note) and 3.1 (a/i open a
" 1-dash-gap slot for a note on every string). These exercise the note-entry
" functions; the buffer key mappings are glue, untested by design (like || and
" _), except the two integration smoke tests at the end that type the keys.

" --- 3.3 EnterNote: replace a dash with the digit on the current tab line ---

" Test: a digit enters the note on an empty slot

Execute:
  filetype plugin on
  enew!
  call setline(1, 'e|---|')
  setfiletype songwriter
  call cursor(1, 4)
  call SongwriterEnterNote('5')
Then:
  AssertEqual 'e|-5-|', getline(1)
  AssertEqual 4, col('.')

" Test: a second digit appends to keep a two-digit fret

Execute:
  filetype plugin on
  enew!
  call setline(1, 'e|-1-|')
  setfiletype songwriter
  call cursor(1, 4)
  call SongwriterEnterNote('8')
Then:
  AssertEqual 'e|-18-|', getline(1)
  AssertEqual 5, col('.')

" Test: a digit is a no-op off a tab line

Execute:
  enew!
  call setline(1, 'I walk a')
  call cursor(1, 1)
Then:
  AssertEqual 'I walk a', getline(1)
  AssertEqual 1, col('.')

" --- 3.1 AddNote: a opens a 1-dash-gap slot to the right, i mirrors to the
" left, on every string of the block. The new-note slot sits one dash from the
" current note; the following/preceding pipe stays 2 dashes away. `a` lands on
" the new slot; `i` lands on its mirrored slot.

" Test: a adds room to the right: 1 dash after the current note, 2 before the pipe

Execute:
  filetype plugin on
  enew!
  call setline(1, 'e|--4--|--|')
  call append(1, 'B|--4--|--|')
  setfiletype songwriter
  call cursor(1, 5)
  call SongwriterAddNote(1)
Then:
  AssertEqual 'e|--4----|--|', getline(1)
  AssertEqual 'B|--4----|--|', getline(2)
  AssertEqual 7, col('.')
  AssertEqual 1, line('.')

" Test: i is the mirror of a, opening a room to the left of the current note

Execute:
  filetype plugin on
  enew!
  call setline(1, 'e|--|--4--|')
  call append(1, 'B|--|--4--|')
  setfiletype songwriter
  call cursor(1, 8)
  call SongwriterAddNote(-1)
Then:
  AssertEqual 'e|--|----4--|', getline(1)
  AssertEqual 'B|--|----4--|', getline(2)
  AssertEqual 8, col('.')
  AssertEqual 1, line('.')

" Test: a is a no-op off a tab block

Execute:
  enew!
  call setline(1, 'I walk a')
  call cursor(1, 1)
  call SongwriterAddNote(1)
Then:
  AssertEqual 'I walk a', getline(1)

" --- Integration smoke tests: the buffer mappings fire in tablature mode ---

" Test: typing a in tablature mode opens a 1-dash-gap slot for a note

Execute:
  filetype plugin on
  enew!
  call setline(1, 'e|--4--|--|')
  call append(1, 'B|--4--|--|')
  setfiletype songwriter
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  normal a
Then:
  AssertEqual 'e|--4----|--|', getline(1)
  AssertEqual 'B|--4----|--|', getline(2)
  AssertEqual 7, col('.')

" Test: typing a digit in tablature mode enters the note

Execute:
  filetype plugin on
  enew!
  call setline(1, 'e|----|')
  setfiletype songwriter
  let b:songwriter_tabmode = 1
  call cursor(1, 3)
  normal 4
Then:
  AssertEqual 'e|4---|', getline(1)
  AssertEqual 3, col('.')
