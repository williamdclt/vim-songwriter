" Spec [Tablature][[Editing]] 3.4 (digits enter a note) and 3.1 (`a`/`i` open a
" slot for a new note on every string). Function-level tests, plus integration
" smoke tests at the end that type the keys.

Before:
  unlet! b:songwriter_tabmode b:songwriter_slot b:songwriter_typing

" --- 3.4 EnterNote: replace a dash with the digit on the current tab line ---

Given songwriter (a digit enters the note on an empty slot):
  e|-----|

Execute (a digit enters the note on an empty slot):
  call cursor(1, 5)
  call songwriter#tab#typing#EnterNote('5')
Then:
  AssertEqual 5, col('.')
Expect:
  e|--5--|

Given songwriter (a second digit typed straight after the first makes a two-digit fret):
  e|-----|

Execute (a second digit typed straight after the first makes a two-digit fret):
  call cursor(1, 5)
  call songwriter#tab#typing#EnterNote('1')
  call songwriter#tab#typing#EnterNote('8')
Then:
  AssertEqual 6, col('.')
Expect:
  e|--18--|

Given songwriter (a digit on an existing note replaces it):
  e|--1--|

Execute (a digit on an existing note replaces it):
  call cursor(1, 5)
  call songwriter#tab#typing#EnterNote('8')
Then:
  AssertEqual 5, col('.')
Expect:
  e|--8--|

Given songwriter (a digit on either digit of an existing two-digit note replaces the whole note):
  e|--12--|

Execute (a digit on either digit of an existing two-digit note replaces the whole note):
  call cursor(1, 6)
  call songwriter#tab#typing#EnterNote('3')
Then:
  AssertEqual 5, col('.')
Expect:
  e|--3--|

Given songwriter (after moving to another note, a digit replaces it rather than appending):
  e|--1--2--|

Execute (after moving to another note, a digit replaces it rather than appending):
  call cursor(1, 5)
  call songwriter#tab#typing#EnterNote('5')
  call cursor(1, 8)
  call songwriter#tab#typing#EnterNote('7')
Expect:
  e|--5--7--|

Given songwriter (typing a digit on a note in tablature mode replaces it):
  e|--1--|

Execute (typing a digit on a note in tablature mode replaces it):
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  normal 7
Expect:
  e|--7--|

Given (a digit is a no-op off a tab line):
  I walk a

Execute (a digit is a no-op off a tab line):
  call cursor(1, 1)
Then:
  AssertEqual 1, col('.')
Expect:
  I walk a

" --- 3.1 AddNote: a opens a 1-dash-gap slot to the right, i mirrors to the
" left, on every string of the block. The new-note slot sits one dash from the
" current note; the following/preceding pipe stays 2 dashes away. `a` lands on
" the new slot; `i` lands on its mirrored slot.

Given songwriter (a adds room to the right: 1 dash after the current note, 2 before the pipe):
  e|--4--|--5--|
  B|--4--|-----|

Execute (a adds room to the right: 1 dash after the current note, 2 before the pipe):
  call cursor(1, 5)
  call songwriter#tab#slots#AddNote(1)
Then:
  AssertEqual 7, col('.')
  AssertEqual 1, line('.')
Expect:
  e|--4----|--5--|
  B|--4----|-----|

Given songwriter (i is the mirror of a, opening a room to the left of the current note):
  e|-----|--4--|
  B|-----|--4--|

Execute (i is the mirror of a, opening a room to the left of the current note):
  call cursor(1, 11)
  call songwriter#tab#slots#AddNote(-1)
Then:
  AssertEqual 11, col('.')
  AssertEqual 1, line('.')
Expect:
  e|-----|----4--|
  B|-----|----4--|

Given songwriter (a anchors on the note under the cursor, not the bar's last note):
  e|--3--5--|
  B|--3--5--|

Execute (a anchors on the note under the cursor, not the bar's last note):
  call cursor(1, 5)
  call songwriter#tab#slots#AddNote(1)
Then:
  AssertEqual 7, col('.')
Expect:
  e|--3---5--|
  B|--3---5--|

Given songwriter (a keeps a 1-dash gap with a next note on another string):
  e|--3----|
  B|----5--|

Execute (a keeps a 1-dash gap with a next note on another string):
  call cursor(1, 5)
  call songwriter#tab#slots#AddNote(1)
Then:
  AssertEqual 7, col('.')
Expect:
  e|--3------|
  B|------5--|

Given songwriter (i keeps a 1-dash gap with the previous note):
  e|--3--5--|
  B|--3--5--|

Execute (i keeps a 1-dash gap with the previous note):
  call cursor(1, 8)
  call songwriter#tab#slots#AddNote(-1)
Then:
  AssertEqual 7, col('.')
Expect:
  e|--3---5--|
  B|--3---5--|

Given songwriter (i keeps a 1-dash gap with a previous note on another string):
  e|----5--|
  B|--3----|

Execute (i keeps a 1-dash gap with a previous note on another string):
  call cursor(1, 7)
  call songwriter#tab#slots#AddNote(-1)
Then:
  AssertEqual 7, col('.')
Expect:
  e|------5--|
  B|--3------|

Given songwriter (i anchors on a two-digit note when the cursor is on its second digit):
  e|--3--12--|
  B|--3------|

Execute (i anchors on a two-digit note when the cursor is on its second digit):
  call cursor(1, 9)
  call songwriter#tab#slots#AddNote(-1)
Then:
  AssertEqual 7, col('.')
Expect:
  e|--3---12--|
  B|--3-------|

Given (a is a no-op off a tab block):
  I walk a

Execute (a is a no-op off a tab block):
  call cursor(1, 1)
  call songwriter#tab#slots#AddNote(1)
Expect:
  I walk a

" --- Integration smoke tests: the buffer mappings fire in tablature mode ---

Given songwriter (typing a in tablature mode opens a 1-dash-gap slot for a note):
  e|--4--|--5--|
  B|--4--|-----|

Execute (typing a in tablature mode opens a 1-dash-gap slot for a note):
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  normal a
Then:
  AssertEqual 7, col('.')
Expect:
  e|--4----|--5--|
  B|--4----|-----|

Given songwriter (typing a in tablature mode on a tab without a closing pipe keeps its notes):
  e|--4--5--

Execute (typing a in tablature mode on a tab without a closing pipe keeps its notes):
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  normal a
Then:
  AssertEqual 7, col('.')
Expect:
  e|--4---5--|

Given songwriter (typing a digit in tablature mode on a tab without a closing pipe enters the note):
  e|-----

Execute (typing a digit in tablature mode on a tab without a closing pipe enters the note):
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  normal 4
Then:
  AssertEqual 5, col('.')
Expect:
  e|--4--|

Given songwriter (typing a digit in tablature mode enters the note):
  e|-----|

Execute (typing a digit in tablature mode enters the note):
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  normal 4
Then:
  AssertEqual 5, col('.')
Expect:
  e|--4--|
