" Spec [Tablature][[Editing]] 3.3 across bars: `l` crosses bar pipes, except on
" the last note of the current bar, where it opens a slot in that bar; a second
" `l` (from the slot) moves on to the next bar's note. `h` crosses back.

Before:
  unlet! b:songwriter_tabmode

Given songwriter (l on the last note of bar 1 opens a slot in bar 1 (does not skip to bar 2)):
  e|--4--|--2--|
  b|------|------|

Execute (l on the last note of bar 1 opens a slot in bar 1 (does not skip to bar 2)):
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  call songwriter#tab#MoveColumn(1)
Then:
  AssertEqual 7, col('.')
Expect:
  e|--4----|--2--|
  b|--------|------|

Given songwriter (pressing l again from the opened space crosses the bar to bar 2's note):
  e|--4----|--2--|
  b|--------|------|

Execute (pressing l again from the opened space crosses the bar to bar 2's note):
  let b:songwriter_tabmode = 1
  call cursor(1, 7)
  call songwriter#tab#MoveColumn(1)
Then:
  AssertEqual 13, col('.')
  AssertEqual 'e|--4----|--2--|', getline(1)

Given songwriter (h moves block-wide back across the bar to the previous note (no prepend)):
  e|--4--|--2--|
  b|------|------|

Execute (h moves block-wide back across the bar to the previous note (no prepend)):
  let b:songwriter_tabmode = 1
  call cursor(1, 11)
  call songwriter#tab#MoveColumn(-1)
Then:
  AssertEqual 5, col('.')
  AssertEqual 'e|--4--|--2--|', getline(1)
