" Test: single-bracket section is highlighted as songwriterSection

Execute:
  enew!
  call setline(1, '[Chorus]')
  setfiletype songwriter
  call cursor(1, 2)
Then:
  AssertEqual 'songwriterSection', synIDattr(synID(line('.'), col('.'), 1), 'name')

" Test: double-bracket subsection is highlighted as songwriterSection

Execute:
  enew!
  call setline(1, '[[Rendering]]')
  setfiletype songwriter
  call cursor(1, 3)
Then:
  AssertEqual 'songwriterSection', synIDattr(synID(line('.'), col('.'), 1), 'name')

" Test: double-bracket subsection with spaces is highlighted as songwriterSection

Execute:
  enew!
  call setline(1, '[[My Subsection]]')
  setfiletype songwriter
  call cursor(1, 4)
Then:
  AssertEqual 'songwriterSection', synIDattr(synID(line('.'), col('.'), 1), 'name')

" Test: plain text is not highlighted as songwriterSection

Execute:
  enew!
  call setline(1, 'just some prose')
  setfiletype songwriter
  call cursor(1, 1)
Then:
  AssertNotEqual 'songwriterSection', synIDattr(synID(line('.'), col('.'), 1), 'name')
