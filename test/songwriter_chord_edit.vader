" Test: insert chord above cursor with alignment

Execute:
  enew!
  call setline(1, 'Hello world')
  call cursor(1, 8)
  call songwriter#chord#ChordAbove('Am7')
Then:
  AssertEqual 2, line('$')
  AssertEqual '       Am7', getline(1)
  AssertEqual 'Hello world', getline(2)

" Test: insert chord at beginning of line

Execute:
  enew!
  call setline(1, 'Hello world')
  call cursor(1, 1)
  call songwriter#chord#ChordAbove('C')
Then:
  AssertEqual 2, line('$')
  AssertEqual 'C', getline(1)
  AssertEqual 'Hello world', getline(2)

" Test: change chord quality

Execute:
  enew!
  call setline(1, '             Am7')
  call cursor(1, 14)
  call songwriter#chord#ChordQuality('maj7')
Then:
  AssertEqual '             Amaj7', getline(1)

" Test: toggle minor to major

Execute:
  enew!
  call setline(1, 'Am')
  call cursor(1, 1)
  call songwriter#chord#ToggleMinorMajor()
Then:
  AssertEqual 'A', getline(1)

" Test: toggle major to minor

Execute:
  enew!
  call setline(1, 'C')
  call cursor(1, 1)
  call songwriter#chord#ToggleMinorMajor()
Then:
  AssertEqual 'Cm', getline(1)

" Test: toggle does not affect quality (m7 stays m7)

Execute:
  enew!
  call setline(1, 'Am7')
  call cursor(1, 1)
  call songwriter#chord#ToggleMinorMajor()
Then:
  AssertEqual 'A7', getline(1)
