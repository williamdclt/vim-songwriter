" Spec [Tablature][[Editing]] 11: `]` / `[` move the note under the cursor one
" fret up / down. Pure cases call songwriter#tab#frets#Shift(lines, lin, col, n)
" (block lines 0-indexed, columns 1-indexed); key cases type the keys in
" tablature mode.

Before:
  unlet! b:songwriter_tabmode b:songwriter_slot b:songwriter_typing b:songwriter_repeat
  unlet! g:songwriter_max_fret
  let b:songwriter_tabmode = 1

" --- 11.1 the note changes fret, in place ---

Execute (11.1 a note goes up and down a fret):
  let r = songwriter#tab#frets#Shift(['e|--5--|', 'B|--3--|'], 0, 5, 1)
  AssertEqual ['e|--6--|', 'B|--3--|'], r.lines
  AssertEqual [0, 5], [r.lin, r.col]
  let r = songwriter#tab#frets#Shift(['e|--5--|', 'B|--3--|'], 1, 5, -1)
  AssertEqual ['e|--5--|', 'B|--2--|'], r.lines
  AssertEqual [1, 5], [r.lin, r.col]

Execute (11.1 only the note under the cursor changes, not its chain):
  let r = songwriter#tab#frets#Shift(['G|--5h7--|'], 0, 7, 1)
  AssertEqual ['G|--5h8--|'], r.lines
  let r = songwriter#tab#frets#Shift(['G|--5h7--|'], 0, 5, -1)
  AssertEqual ['G|--4h7--|'], r.lines

Execute (11.1 a two-digit note, the cursor on either digit):
  let r = songwriter#tab#frets#Shift(['e|--12--|'], 0, 6, 1)
  AssertEqual ['e|--13--|'], r.lines
  AssertEqual 6, r.col

" --- 11.2 width changes ---

Execute (11.2 a note getting wider takes the dash after it):
  let r = songwriter#tab#frets#Shift(['e|--9---5--|', 'B|--9---5--|'], 0, 5, 1)
  AssertEqual ['e|--10--5--|', 'B|--9---5--|'], r.lines
  AssertEqual 5, r.col

Execute (11.2 a note getting wider makes room on every string, as 7.5):
  let r = songwriter#tab#frets#Shift(['e|--9-5--|', 'B|--9-5--|'], 0, 5, 1)
  AssertEqual ['e|--10-5--|', 'B|--9--5--|'], r.lines

Execute (11.2 a note getting wider keeps its separators):
  let r = songwriter#tab#frets#Shift(['G|--9h11--|', 'D|--------|'], 0, 5, 1)
  AssertEqual ['G|--10h11-|', 'D|--------|'], r.lines

Execute (11.2 a note getting narrower leaves a dash after its chain):
  let r = songwriter#tab#frets#Shift(['e|--10--5--|'], 0, 6, -1)
  AssertEqual ['e|--9---5--|'], r.lines
  AssertEqual 5, r.col
  let r = songwriter#tab#frets#Shift(['G|--10h12--|'], 0, 5, -1)
  AssertEqual ['G|--9h12---|'], r.lines

" --- 11.3 refusals ---

Execute (11.3 no fretted note under the cursor):
  for c in [3, 4, 6]
    let r = songwriter#tab#frets#Shift(['e|--5h7--|'], 0, c, 1)
    AssertEqual 'no fretted note under the cursor', r.error
  endfor
  let r = songwriter#tab#frets#Shift(['e|--x--|'], 0, 5, 1)
  AssertEqual 'no fretted note under the cursor', r.error

Execute (11.3 below fret 0):
  let r = songwriter#tab#frets#Shift(['e|--0--|'], 0, 5, -1)
  AssertEqual 'the fret would go below 0', r.error

Execute (11.3 above the highest fret, g:songwriter_max_fret):
  let r = songwriter#tab#frets#Shift(['e|--24--|'], 0, 5, 1)
  AssertEqual 'the fret would go above 24', r.error
  let g:songwriter_max_fret = 22
  let r = songwriter#tab#frets#Shift(['e|--22--|'], 0, 5, 1)
  AssertEqual 'the fret would go above 22', r.error

" --- keys ---

Given songwriter (] moves the note up a fret, the cursor stays on it):
  e|--5--3--|
  B|--5-----|

Execute (] moves the note up a fret, the cursor stays on it):
  call cursor(1, 5)
  normal ]
Then:
  AssertEqual [1, 5], [line('.'), col('.')]
Expect songwriter:
  e|--6--3--|
  B|--5-----|

Given songwriter ([ moves the note down a fret):
  e|--5--3--|

Execute ([ moves the note down a fret):
  call cursor(1, 8)
  normal [
Expect songwriter:
  e|--5--2--|

Given songwriter (] widening a note, then the tab is linted):
  e|--9-5--|
  B|--9-5--|

Execute (] widening a note, then the tab is linted):
  call cursor(2, 5)
  normal ]
Then:
  AssertEqual [2, 5], [line('.'), col('.')]
Expect songwriter:
  e|--9--5--|
  B|--10-5--|

Given songwriter ([ narrowing a note, then the tab is linted):
  e|--10--|

Execute ([ narrowing a note, then the tab is linted):
  call cursor(1, 6)
  normal [
Then:
  AssertEqual [1, 5], [line('.'), col('.')]
Expect songwriter:
  e|--9--|

Given songwriter (a refused fret change leaves the tab unchanged):
  e|--0--|

Execute (a refused fret change leaves the tab unchanged):
  call cursor(1, 5)
  normal [
Expect songwriter:
  e|--0--|

Given songwriter (a fret change and its lint are one undo step):
  e|--9-5--|

Execute (a fret change and its lint are one undo step):
  call cursor(1, 5)
  normal ]
  normal u
Expect songwriter:
  e|--9-5--|

Given songwriter (. repeats the fret change):
  e|--9--|

Execute (. repeats the fret change):
  call cursor(1, 5)
  normal [
  normal .
Expect songwriter:
  e|--7--|

Given songwriter (off tablature mode, ] and [ keep their meaning):
  e|--5--|

Execute (off tablature mode, ] and [ keep their meaning):
  let b:songwriter_tabmode = 0
  call cursor(1, 5)
  normal ]]
Expect songwriter:
  e|--5--|
