" Test: add bar inserts | at cursor column across all tab strings

Execute:
  enew!
  call setline(1, 'e|-----------4--|--1-----------|')
  call append(1, 'B|--------1-----|-----2-----2--|')
  call append(2, 'G|--3-----0--0--|-----1--0--0--|')
  call append(3, 'D|--------1-----|-----1--------|')
  call append(4, 'A|--4--3--------|--1-----1-----|')
  call append(5, 'E|--3-----------|--1-----------|')
  call cursor(1, 14)
  call songwriter#tab#AddBar()
Then:
  AssertEqual 'e|-----------4|--|--1-----------|', getline(1)
  AssertEqual 'B|--------1---|--|-----2-----2--|', getline(2)
  AssertEqual 'G|--3-----0--0|--|-----1--0--0--|', getline(3)
  AssertEqual 'D|--------1---|--|-----1--------|', getline(4)
  AssertEqual 'A|--4--3------|--|--1-----1-----|', getline(5)
  AssertEqual 'E|--3---------|--|--1-----------|', getline(6)

" Test: add bar pads short lines with dashes before inserting |

Execute:
  enew!
  call setline(1, 'e|--4--|')
  call append(1, 'B|------|')
  call append(2, 'G|------|')
  call append(3, 'D|------|')
  call append(4, 'A|------|')
  call append(5, 'E|------|')
  call cursor(1, 6)
  call songwriter#tab#AddBar()
Then:
  AssertEqual 'e|--4-|-|', getline(1)
  AssertEqual 'B|----|--|', getline(2)
  AssertEqual 'G|----|--|', getline(3)
  AssertEqual 'D|----|--|', getline(4)
  AssertEqual 'A|----|--|', getline(5)
  AssertEqual 'E|----|--|', getline(6)

" Test: add bar does nothing on non-tab lines

Execute:
  enew!
  call setline(1, 'some prose line')
  call append(1, 'another line')
  call cursor(1, 1)
  call songwriter#tab#AddBar()
Then:
  AssertEqual 'some prose line', getline(1)
  AssertEqual 'another line', getline(2)
