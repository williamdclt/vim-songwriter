" Spec [Tablature][[Editing]] 12: playing notes. The sound itself is off
" (g:songwriter_player = []): what would be played is read back with
" songwriter#sound#Last().

Before:
  unlet! b:songwriter_tabmode b:songwriter_slot b:songwriter_typing b:songwriter_insert b:songwriter_carry
  let b:songwriter_tabmode = 1
  let g:songwriter_player = []
  call songwriter#sound#Stop()

After:
  unlet! g:songwriter_player g:songwriter_play_bpm

" === Pitches (12.3) ===

Execute (12.3 standard tuning is E2 to E4):
  AssertEqual {'midi': [64, 59, 55, 50, 45, 40]},
        \ songwriter#tab#play#OpenPitches(split('eBGDAE', '\zs'))

Execute (12.3 each string is less than an octave above the one below it):
  AssertEqual [62, 57, 55, 50, 45, 38], songwriter#tab#play#OpenPitches(split('dAGDAD', '\zs')).midi

Execute (12.3 the lowest string is between B1 and A#2):
  AssertEqual [64, 59, 55, 50, 45, 40, 35], songwriter#tab#play#OpenPitches(split('eBGDAEB', '\zs')).midi
  AssertEqual [55, 50, 45, 40], songwriter#tab#play#OpenPitches(split('GDAE', '\zs')).midi
  AssertEqual [48, 36], songwriter#tab#play#OpenPitches(['C', 'C']).midi
  AssertEqual [47, 46], songwriter#tab#play#OpenPitches(['B', 'A#']).midi

Execute (12.3 a string name that is not a note):
  AssertEqual {'error': 'songwriter: string name X is not a note'},
        \ songwriter#tab#play#OpenPitches(['e', 'X', 'G'])

" === Steps (12.2) ===

Execute (12.2 one step per time column, its notes from the lowest string up):
  let g:lines = [
        \ 'e|--0--3h5--x--|',
        \ 'B|--1-----------|',
        \ 'G|--------------|',
        \ ]
  AssertEqual [
        \ [{'lin': 1, 'midi': 60}, {'lin': 0, 'midi': 64}],
        \ [{'lin': 0, 'midi': 67}],
        \ [{'lin': 0, 'midi': 69}],
        \ ], songwriter#tab#play#Steps(g:lines, [64, 59, 55], [0, 1, 2], 1, len(g:lines[0]))

Execute (12.2 only the strings and columns given):
  let g:lines = [
        \ 'e|--0--3--|',
        \ 'B|--1--1--|',
        \ ]
  AssertEqual [[{'lin': 1, 'midi': 60}]],
        \ songwriter#tab#play#Steps(g:lines, [64, 59], [1], 4, 6)

Execute (12.2 two-digit frets):
  AssertEqual [[{'lin': 0, 'midi': 76}]],
        \ songwriter#tab#play#Steps(['e|--12--|'], [64], [0], 1, 8)
