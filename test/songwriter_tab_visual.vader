" Spec [Tablature][[Editing]] 6.9: visual mode in tablature mode. Typed
" end-to-end with `normal`; a selection that outlives `normal` is checked
" through visualmode() and the '< '> marks.

Before:
  unlet! b:songwriter_tabmode b:songwriter_slot b:songwriter_typing b:songwriter_repeat
  let b:songwriter_tabmode = 1
  call setreg('"', [])

" --- 6.9.1 text objects select the full-height rectangle ---

Given songwriter (6.9.1 vac selects the column on every string):
  e|--3--5--7--|
  B|-----5-----|

Execute (6.9.1 vac selects the column on every string):
  call cursor(1, 8)
  execute "normal vac\<Esc>"
  AssertEqual "\<C-V>", visualmode()
  AssertEqual [1, 8], getpos("'<")[1:2]
  AssertEqual [2, 10], getpos("'>")[1:2]

Given songwriter (6.9.1 vacd removes the column):
  e|--3--5--7--|
  B|-----5-----|

Execute (6.9.1 vacd removes the column):
  call cursor(1, 8)
  normal vacd
Expect songwriter:
  e|--3--7--|
  B|--------|

Given songwriter (6.9.1 repeating a| extends the selection to the next bar):
  e|--3--|--5--|--7--|

Execute (6.9.1 repeating a| extends the selection to the next bar):
  call cursor(1, 5)
  normal va|a|y
  AssertEqual ['--3--|--5--|'], getreg('"', 1, 1)

Given songwriter (6.9.1 repeating ac extends the selection to the next column):
  e|--3--5--7--|

Execute (6.9.1 repeating ac extends the selection to the next column):
  call cursor(1, 5)
  normal vacacd
Expect songwriter:
  e|--7--|

" --- 6.9.2 plain v is widened at operator time ---

Given songwriter (6.9.2 v with tab motions, then d: widened and snapped):
  e|--3--5--7--|
  B|-----5-----|

Execute (6.9.2 v with tab motions, then d: widened and snapped):
  call cursor(1, 5)
  normal vwd
Expect songwriter:
  e|--7--|
  B|-----|

Given songwriter (6.9.2 v with l moves by column, then y):
  e|--3--------|
  B|-----5-----|

Execute (6.9.2 v with l moves by column, then y):
  call cursor(1, 5)
  normal vly
  AssertEqual ['3--------', '---5-----'], getreg('"', 1, 1)

Given songwriter (6.9.2 a <C-v> on some strings is widened to all of them):
  e|--3--5--|
  B|--1--5--|
  G|--0--5--|

Execute (6.9.2 a <C-v> on some strings is widened to all of them):
  call cursor(1, 5)
  execute "normal \<C-v>jd"
Expect songwriter:
  e|--5--|
  B|--5--|
  G|--5--|

" --- 6.9.3 V: a column selection, limited to the tab ---

Given songwriter (6.9.3 V selects the cursor's column on every string of the tab):
  Intro
  e|--3--5--7--|
  B|-----5-----|
  end

Execute (6.9.3 V selects the cursor's column on every string of the tab):
  call cursor(2, 8)
  execute "normal V\<Esc>"
  AssertEqual "\<C-V>", visualmode()
  AssertEqual [2, 8], getpos("'<")[1:2]
  AssertEqual [3, 8], getpos("'>")[1:2]

Given songwriter (6.9.3 Vd deletes the column under the cursor):
  e|--3--5--7--|
  B|-----5-----|

Execute (6.9.3 Vd deletes the column under the cursor):
  call cursor(1, 8)
  normal Vd
Expect songwriter:
  e|--3--7--|
  B|--------|

Given songwriter (6.9.3 V from a lower string, then l and y, yanks columns):
  e|--3--5--7--|
  B|-----5-----|

Execute (6.9.3 V from a lower string, then l and y, yanks columns):
  call cursor(2, 5)
  normal Vly
  AssertEqual ['3--5--', '---5--'], getreg('"', 1, 1)

Given songwriter (6.9.3 j does not leave the tab's strings):
  Intro
  e|--3--5--|
  B|--1--5--|
  end

Execute (6.9.3 j does not leave the tab's strings):
  call cursor(2, 5)
  execute "normal Vj\<Esc>"
  AssertEqual [2, 5], getpos("'<")[1:2]
  AssertEqual [3, 5], getpos("'>")[1:2]

Given songwriter (6.9.3 k and a count are clamped to the tab):
  Intro
  e|--3--5--|
  B|--1--5--|
  G|--0--5--|
  end

Execute (6.9.3 k and a count are clamped to the tab):
  call cursor(3, 5)
  execute "normal vk\<Esc>"
  AssertEqual [2, 5], getpos("'<")[1:2]
  call cursor(2, 5)
  execute "normal v5j\<Esc>"
  AssertEqual [4, 5], getpos("'>")[1:2]

Given songwriter (6.9.3 a partial <C-v> still moves with j/k):
  e|--3--5--|
  B|--1--5--|
  G|--0--5--|

Execute (6.9.3 a partial <C-v> still moves with j/k):
  call cursor(1, 5)
  execute "normal \<C-v>jjk\<Esc>"
  AssertEqual [2, 5], getpos("'>")[1:2]

Given songwriter (6.9.3 VV switches to whole tabs):
  Intro
  e|--3--|
  B|--1--|
  end

Execute (6.9.3 VV switches to whole tabs):
  call cursor(2, 4)
  normal VVd
Expect songwriter:
  Intro
  end

Given songwriter (6.9.3 outside tablature mode V stays line-wise):
  e|--3--|
  B|--1--|

Execute (6.9.3 outside tablature mode V stays line-wise):
  let b:songwriter_tabmode = 0
  call cursor(1, 4)
  execute "normal V\<Esc>"
  AssertEqual 'V', visualmode()

" --- 6.9.4 visual p ---

Given songwriter (6.9.4 va|p replaces the bar with the register):
  e|--3--|--5--|

Execute (6.9.4 va|p replaces the bar with the register):
  call cursor(1, 5)
  normal ya|
  call cursor(1, 11)
  normal va|p
Expect songwriter:
  e|--3--|--3--|

Given songwriter (6.9.4 vacp replaces the column with the register):
  e|--3--5--7--|

Execute (6.9.4 vacp replaces the column with the register):
  call cursor(1, 5)
  normal yac
  call cursor(1, 11)
  normal vacp
Expect songwriter:
  e|--3--5--3--|

" --- 6.9.5 motions keep visual mode ---

Given songwriter (6.9.5 visual W/B/E move by bar as in normal mode (3.5)):
  e|--3--|--5--7--|

Execute (6.9.5 visual W/B/E move by bar as in normal mode (3.5)):
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  execute "normal vW\<Esc>"
  AssertEqual 11, col("'>")
  call cursor(1, 5)
  execute "normal vE\<Esc>"
  AssertEqual 14, col("'>")
  call cursor(1, 14)
  execute "normal vB\<Esc>"
  AssertEqual 11, col("'<")

Given songwriter (6.9.5 visual W stays in visual mode, outside tablature mode too):
  e|--3--|--5--|

Execute (6.9.5 visual W stays in visual mode, outside tablature mode too):
  let b:songwriter_tabmode = 0
  call cursor(1, 3)
  normal vWd
Expect songwriter:
  e|--5--|
