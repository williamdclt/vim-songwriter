" Spec [Tablature][[Editing]] 3: <leader>t toggles a buffer-local tablature mode
" (b:songwriter_tabmode) in which `w`/`b` move between notes on the current line
" (3.2) and `l`/`h` between note columns of the whole block (3.3). Motions are
" exercised end-to-end via `normal`; the prose no-op guards at function level,
" since off a tab line the keys fall back to their default behaviour.

Before:
  unlet! b:songwriter_tabmode b:songwriter_slot

" --- 3.2 w/b: note on the current line, skipping dashes and pipes ---

Given songwriter (w in tablature mode skips dashes to the next note):
  e|--4--|--1--|

Execute (w in tablature mode skips dashes to the next note):
  let b:songwriter_tabmode = 1
  call cursor(1, 3)
  normal w
Then:
  AssertEqual 5, col('.')

Given songwriter (w in tablature mode skips the bar pipe and dashes to the next note):
  e|--4--|--1--|

Execute (w in tablature mode skips the bar pipe and dashes to the next note):
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  normal w
Then:
  AssertEqual 11, col('.')

Given songwriter (w in tablature mode lands on the first digit of a two-digit fret):
  e|---12---|

Execute (w in tablature mode lands on the first digit of a two-digit fret):
  let b:songwriter_tabmode = 1
  call cursor(1, 3)
  normal w
Then:
  AssertEqual 6, col('.')

Given songwriter (b in tablature mode skips dashes to the previous note):
  e|--4--|--1--|

Execute (b in tablature mode skips dashes to the previous note):
  let b:songwriter_tabmode = 1
  call cursor(1, 6)
  normal b
Then:
  AssertEqual 5, col('.')

Given songwriter (b in tablature mode lands on the first digit of a two-digit fret):
  e|--4---12--|

Execute (b in tablature mode lands on the first digit of a two-digit fret):
  let b:songwriter_tabmode = 1
  call cursor(1, 10)
  normal b
Then:
  AssertEqual 9, col('.')

" --- 3.3 l/h: the next/prev column where ANY line has a note ---

Given songwriter (l in tablature mode skips to a note column that only exists on another string):
  e|----4----|
  B|---2-----|

Execute (l in tablature mode skips to a note column that only exists on another string):
  let b:songwriter_tabmode = 1
  call cursor(1, 3)
  normal l
Then:
  AssertEqual 1, line('.')
  AssertEqual 6, col('.')

Given songwriter (l in tablature mode skips to the next note column on another string):
  e|----4----|
  B|---2-----|

Execute (l in tablature mode skips to the next note column on another string):
  let b:songwriter_tabmode = 1
  call cursor(1, 6)
  normal l
Then:
  AssertEqual 7, col('.')

Given songwriter (h in tablature mode moves to the previous note column on another string):
  e|----4----|
  B|---2-----|

Execute (h in tablature mode moves to the previous note column on another string):
  let b:songwriter_tabmode = 1
  call cursor(1, 8)
  normal h
Then:
  AssertEqual 7, col('.')

" 3.3.4: an empty bar is a stop for l/h, where a slot opens (not a trailing
" one: see 5 in songwriter_tab_move.vader).

Given songwriter (3.3.4 l past the slot of a bar enters the empty bar after it, opening a slot):
  e|--4--|--|--1--|
  B|-----|--|--3--|

Execute (3.3.4 l past the slot of a bar enters the empty bar after it, opening a slot):
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  normal ll
Then:
  AssertEqual 1, line('.')
  AssertEqual 11, col('.')
Expect songwriter:
  e|--4--|-----|--1--|
  B|-----|-----|--3--|

Given songwriter (3.3.4 a digit fills the slot of the empty bar):
  e|--4--|--|--1--|

Execute (3.3.4 a digit fills the slot of the empty bar):
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  normal ll7
Expect songwriter:
  e|--4--|--7--|--1--|

Given songwriter (3.3.4 l on the slot of the empty bar lints it back and moves on):
  e|--4--|--|--1--|

Execute (3.3.4 l on the slot of the empty bar lints it back and moves on):
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  normal lll
Then:
  AssertEqual 17, col('.')
Expect songwriter:
  e|--4--|-----|--1--|

Given songwriter (3.3.4 h enters the empty bar before the cursor, opening a slot):
  e|--4--|--|--1--|

Execute (3.3.4 h enters the empty bar before the cursor, opening a slot):
  let b:songwriter_tabmode = 1
  call cursor(1, 14)
  normal h
Then:
  AssertEqual 11, col('.')
Expect songwriter:
  e|--4--|-----|--1--|

Given songwriter (3.3.4 h on the slot of the empty bar lints it back and moves on):
  e|--4--|--|--1--|

Execute (3.3.4 h on the slot of the empty bar lints it back and moves on):
  let b:songwriter_tabmode = 1
  call cursor(1, 14)
  normal hh
Then:
  AssertEqual 5, col('.')
Expect songwriter:
  e|--4--|-----|--1--|

Given songwriter (3.3.4 h crosses several empty bars one at a time):
  e|--4--|--|--|--1--|

Execute (3.3.4 h crosses several empty bars one at a time):
  let b:songwriter_tabmode = 1
  call cursor(1, 17)
  normal hh
Then:
  AssertEqual 11, col('.')
Expect songwriter:
  e|--4--|-----|-----|--1--|

" --- 3.5 L/H: first time column of the next bar, last of the previous ---

Given songwriter (3.5 L moves to the first note of the next bar):
  e|--4-----|--1--5--|

Execute (3.5 L moves to the first note of the next bar):
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  normal L
Then:
  AssertEqual 14, col('.')

Given songwriter (3.5 L lands on the first time column of any string):
  e|--4--|-----1--|
  B|--5--|--3-----|

Execute (3.5 L lands on the first time column of any string):
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  normal L
Then:
  AssertEqual [1, 11], [line('.'), col('.')]

Given songwriter (3.5 H moves to the last time column of the previous bar):
  e|--4--5--|--1--|

Execute (3.5 H moves to the last time column of the previous bar):
  let b:songwriter_tabmode = 1
  call cursor(1, 14)
  normal H
Then:
  AssertEqual 8, col('.')

Given songwriter (3.5 L from the string name or the opening pipe enters the first bar):
  e|--4--|--1--|

Execute (3.5 L from the string name or the opening pipe enters the first bar):
  let b:songwriter_tabmode = 1
  call cursor(1, 1)
  normal L
  AssertEqual 5, col('.')
  call cursor(1, 2)
  normal L
  AssertEqual 5, col('.')

Given songwriter (3.5 L on a pipe enters the bar after it, H the bar before it):
  e|--4--|--1--|

Execute (3.5 L on a pipe enters the bar after it, H the bar before it):
  let b:songwriter_tabmode = 1
  call cursor(1, 8)
  normal L
  AssertEqual 11, col('.')
  call cursor(1, 8)
  normal H
  AssertEqual 5, col('.')

Given songwriter (3.5 L in the last bar and H in the first bar stay put):
  e|--4--|--1--|

Execute (3.5 L in the last bar and H in the first bar stay put):
  let b:songwriter_tabmode = 1
  call cursor(1, 11)
  normal L
  AssertEqual 11, col('.')
  call cursor(1, 5)
  normal H
  AssertEqual 5, col('.')

Given songwriter (3.5 L/H into an empty bar land next to the pipe they cross):
  e|--4--|--|--1--|

Execute (3.5 L/H into an empty bar land next to the pipe they cross):
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  normal L
  AssertEqual 9, col('.')
  call cursor(1, 14)
  normal H
  AssertEqual 10, col('.')

Given songwriter (3.5 L abandons an open slot, linting it away):
  e|--4--|--1--|

Execute (3.5 L abandons an open slot, linting it away):
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  normal aL
  AssertEqual 11, col('.')
Expect songwriter:
  e|--4--|--1--|

Given songwriter (3.5 L/H keep the pipe motion outside tablature mode):
  e|--4--|--1--|

Execute (3.5 L/H keep the pipe motion outside tablature mode):
  let b:songwriter_tabmode = 0
  call cursor(1, 5)
  normal L
  AssertEqual 8, col('.')

" --- Mode toggle and no-op guards ---

Given songwriter (<leader>t toggle turns tablature mode on and off):
  e|----|

Execute (<leader>t toggle turns tablature mode on and off):
  AssertEqual 0, songwriter#keys#InTabMode()
  call songwriter#keys#ToggleTabMode()
  AssertEqual 1, b:songwriter_tabmode
  call songwriter#keys#ToggleTabMode()
  AssertEqual 0, b:songwriter_tabmode

Given songwriter (w stays put on a prose line even in tablature mode (function no-op)):
  I walk a

Execute (w stays put on a prose line even in tablature mode (function no-op)):
  let b:songwriter_tabmode = 1
  call cursor(1, 1)
  call songwriter#tab#MoveNote(1)
Then:
  AssertEqual 1, col('.')

Given songwriter (l stays put on a prose line even in tablature mode (function no-op)):
  I walk a

Execute (l stays put on a prose line even in tablature mode (function no-op)):
  let b:songwriter_tabmode = 1
  call cursor(1, 1)
  call songwriter#tab#MoveColumn(1)
Then:
  AssertEqual 1, col('.')
