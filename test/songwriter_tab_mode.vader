" Spec [Tablature][[Editing]] 3: <leader>t toggles a buffer-local tablature mode
" (b:songwriter_tabmode) in which `w`/`b` move between notes on the current line
" (3.2) and `l`/`h` between note columns of the whole block (3.3). Motions are
" exercised end-to-end via `normal`; the prose no-op guards at function level,
" since off a tab line the keys fall back to their default behaviour.

Before:
  unlet! b:songwriter_tabmode b:songwriter_slot

" --- 3.2 w/b: note on the current line, skipping dashes and pipes ---

Given songwriter (w in tablature mode skips dashes to the next note):
  e|--4--|--1--|

Execute (w in tablature mode skips dashes to the next note):
  let b:songwriter_tabmode = 1
  call cursor(1, 3)
  normal w
Then:
  AssertEqual 5, col('.')

Given songwriter (w in tablature mode skips the bar pipe and dashes to the next note):
  e|--4--|--1--|

Execute (w in tablature mode skips the bar pipe and dashes to the next note):
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  normal w
Then:
  AssertEqual 11, col('.')

Given songwriter (w in tablature mode lands on the first digit of a two-digit fret):
  e|---12---|

Execute (w in tablature mode lands on the first digit of a two-digit fret):
  let b:songwriter_tabmode = 1
  call cursor(1, 3)
  normal w
Then:
  AssertEqual 6, col('.')

Given songwriter (b in tablature mode skips dashes to the previous note):
  e|--4--|--1--|

Execute (b in tablature mode skips dashes to the previous note):
  let b:songwriter_tabmode = 1
  call cursor(1, 6)
  normal b
Then:
  AssertEqual 5, col('.')

Given songwriter (b in tablature mode lands on the first digit of a two-digit fret):
  e|--4---12--|

Execute (b in tablature mode lands on the first digit of a two-digit fret):
  let b:songwriter_tabmode = 1
  call cursor(1, 10)
  normal b
Then:
  AssertEqual 9, col('.')

" --- 3.3 l/h: the next/prev column where ANY line has a note ---

Given songwriter (l in tablature mode skips to a note column that only exists on another string):
  e|----4----|
  B|---2-----|

Execute (l in tablature mode skips to a note column that only exists on another string):
  let b:songwriter_tabmode = 1
  call cursor(1, 3)
  normal l
Then:
  AssertEqual 1, line('.')
  AssertEqual 6, col('.')

Given songwriter (l in tablature mode skips to the next note column on another string):
  e|----4----|
  B|---2-----|

Execute (l in tablature mode skips to the next note column on another string):
  let b:songwriter_tabmode = 1
  call cursor(1, 6)
  normal l
Then:
  AssertEqual 7, col('.')

Given songwriter (h in tablature mode moves to the previous note column on another string):
  e|----4----|
  B|---2-----|

Execute (h in tablature mode moves to the previous note column on another string):
  let b:songwriter_tabmode = 1
  call cursor(1, 8)
  normal h
Then:
  AssertEqual 7, col('.')

" 3.3.2-3.3.4 and the insert state: see songwriter_tab_move.vader.

" --- 3.5 W/B/E: bar motions, as WORD motions are a bigger w/b/e ---

Given songwriter (3.5 W moves to the first time column of the next bar):
  e|--4-----|--1--5--|

Execute (3.5 W moves to the first time column of the next bar):
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  normal W
Then:
  AssertEqual 14, col('.')

Given songwriter (3.5 W lands on the first time column of any string):
  e|--4--|-----1--|
  B|--5--|--3-----|

Execute (3.5 W lands on the first time column of any string):
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  normal W
Then:
  AssertEqual [1, 11], [line('.'), col('.')]

Given songwriter (3.5 E moves to the last time column of the bar, then of the next one):
  e|--4--6--|--1--5--|

Execute (3.5 E moves to the last time column of the bar, then of the next one):
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  normal E
  AssertEqual 8, col('.')
  normal E
  AssertEqual 17, col('.')
  normal E
  AssertEqual 17, col('.')

Given songwriter (3.5 B moves to the first time column of the bar, then of the previous one):
  e|--4--6--|--1--5--|

Execute (3.5 B moves to the first time column of the bar, then of the previous one):
  let b:songwriter_tabmode = 1
  call cursor(1, 17)
  normal B
  AssertEqual 14, col('.')
  normal B
  AssertEqual 5, col('.')
  normal B
  AssertEqual 5, col('.')

Given songwriter (3.5 B before the first note of a bar goes to the previous bar):
  e|--4--|--1--|

Execute (3.5 B before the first note of a bar goes to the previous bar):
  let b:songwriter_tabmode = 1
  call cursor(1, 10)
  normal B
Then:
  AssertEqual 5, col('.')

Given songwriter (3.5 W/E from the string name enter the first bar, B stays):
  e|--4--5--|--1--|

Execute (3.5 W/E from the string name enter the first bar, B stays):
  let b:songwriter_tabmode = 1
  call cursor(1, 1)
  normal W
  AssertEqual 5, col('.')
  call cursor(1, 1)
  normal E
  AssertEqual 8, col('.')
  call cursor(1, 1)
  normal B
  AssertEqual 1, col('.')

Given songwriter (3.5 on a pipe, W/E take the bar after it and B the bar before it):
  e|--4--6--|--1--5--|

Execute (3.5 on a pipe, W/E take the bar after it and B the bar before it):
  let b:songwriter_tabmode = 1
  call cursor(1, 11)
  normal W
  AssertEqual 14, col('.')
  call cursor(1, 11)
  normal E
  AssertEqual 17, col('.')
  call cursor(1, 11)
  normal B
  AssertEqual 5, col('.')

Given songwriter (3.5 W in the last bar stays):
  e|--4--|--1--|

Execute (3.5 W in the last bar stays):
  let b:songwriter_tabmode = 1
  call cursor(1, 11)
  normal W
Then:
  AssertEqual 11, col('.')

Given songwriter (3.5 a bar with no note: its middle dash):
  e|--4--|-----|--1--|

Execute (3.5 a bar with no note: its middle dash):
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  normal W
  AssertEqual 11, col('.')
  call cursor(1, 5)
  normal E
  AssertEqual 11, col('.')
  call cursor(1, 17)
  normal B
  AssertEqual 11, col('.')

Given songwriter (3.5 a count moves that many bars):
  e|--4--|--1--|--2--|

Execute (3.5 a count moves that many bars):
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  call songwriter#tab#MoveBar('W', 2)
Then:
  AssertEqual 17, col('.')

Given songwriter (3.5 W closes an open slot):
  e|--4--|--1--|

Execute (3.5 W closes an open slot):
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  normal aW
  AssertEqual 11, col('.')
Expect songwriter:
  e|--4--|--1--|

Given songwriter (3.5 L/H keep their native meaning in tablature mode):
  e|--4--|--1--|
  B|--4--|--1--|

Execute (3.5 L/H keep their native meaning in tablature mode):
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  normal L
  AssertEqual 2, line('.')
  normal H
  AssertEqual 1, line('.')

Given songwriter (3.5 W/B keep the pipe motion outside tablature mode):
  e|--4--|--1--|

Execute (3.5 W/B keep the pipe motion outside tablature mode):
  let b:songwriter_tabmode = 0
  call cursor(1, 5)
  normal W
  AssertEqual 8, col('.')
  normal B
  AssertEqual 2, col('.')

" --- Mode toggle and no-op guards ---

Given songwriter (<leader>t toggle turns tablature mode on and off):
  e|----|

Execute (<leader>t toggle turns tablature mode on and off):
  AssertEqual 0, songwriter#keys#InTabMode()
  call songwriter#keys#ToggleTabMode()
  AssertEqual 1, b:songwriter_tabmode
  call songwriter#keys#ToggleTabMode()
  AssertEqual 0, b:songwriter_tabmode

Given songwriter (w stays put on a prose line even in tablature mode (function no-op)):
  I walk a

Execute (w stays put on a prose line even in tablature mode (function no-op)):
  let b:songwriter_tabmode = 1
  call cursor(1, 1)
  call songwriter#tab#MoveNote(1)
Then:
  AssertEqual 1, col('.')
