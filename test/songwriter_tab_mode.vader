" Spec [Tablature][[Editing]] 3: <leader>t toggles a buffer-local tablature mode
" (b:songwriter_tabmode) in which `w`/`b` move between notes on the current line
" (3.2) and `l`/`h` between note columns of the whole block (3.3). Motions are
" exercised end-to-end via `normal`; the prose no-op guards at function level,
" since off a tab line the keys fall back to their default behaviour.

Before:
  unlet! b:songwriter_tabmode b:songwriter_slot

" --- 3.2 w/b: note on the current line, skipping dashes and pipes ---

Given songwriter (w in tablature mode skips dashes to the next note):
  e|--4--|--1--|

Execute (w in tablature mode skips dashes to the next note):
  let b:songwriter_tabmode = 1
  call cursor(1, 3)
  normal w
Then:
  AssertEqual 5, col('.')

Given songwriter (w in tablature mode skips the bar pipe and dashes to the next note):
  e|--4--|--1--|

Execute (w in tablature mode skips the bar pipe and dashes to the next note):
  let b:songwriter_tabmode = 1
  call cursor(1, 5)
  normal w
Then:
  AssertEqual 11, col('.')

Given songwriter (w in tablature mode lands on the first digit of a two-digit fret):
  e|---12---|

Execute (w in tablature mode lands on the first digit of a two-digit fret):
  let b:songwriter_tabmode = 1
  call cursor(1, 3)
  normal w
Then:
  AssertEqual 6, col('.')

Given songwriter (b in tablature mode skips dashes to the previous note):
  e|--4--|--1--|

Execute (b in tablature mode skips dashes to the previous note):
  let b:songwriter_tabmode = 1
  call cursor(1, 6)
  normal b
Then:
  AssertEqual 5, col('.')

Given songwriter (b in tablature mode lands on the first digit of a two-digit fret):
  e|--4---12--|

Execute (b in tablature mode lands on the first digit of a two-digit fret):
  let b:songwriter_tabmode = 1
  call cursor(1, 10)
  normal b
Then:
  AssertEqual 9, col('.')

" --- 3.3 l/h: the next/prev column where ANY line has a note ---

Given songwriter (l in tablature mode skips to a note column that only exists on another string):
  e|----4----|
  B|---2-----|

Execute (l in tablature mode skips to a note column that only exists on another string):
  let b:songwriter_tabmode = 1
  call cursor(1, 3)
  normal l
Then:
  AssertEqual 1, line('.')
  AssertEqual 6, col('.')

Given songwriter (l in tablature mode skips to the next note column on another string):
  e|----4----|
  B|---2-----|

Execute (l in tablature mode skips to the next note column on another string):
  let b:songwriter_tabmode = 1
  call cursor(1, 6)
  normal l
Then:
  AssertEqual 7, col('.')

Given songwriter (h in tablature mode moves to the previous note column on another string):
  e|----4----|
  B|---2-----|

Execute (h in tablature mode moves to the previous note column on another string):
  let b:songwriter_tabmode = 1
  call cursor(1, 8)
  normal h
Then:
  AssertEqual 7, col('.')

" --- Mode toggle and no-op guards ---

Given songwriter (<leader>t toggle turns tablature mode on and off):
  e|----|

Execute (<leader>t toggle turns tablature mode on and off):
  AssertEqual 0, songwriter#keys#InTabMode()
  call songwriter#keys#ToggleTabMode()
  AssertEqual 1, b:songwriter_tabmode
  call songwriter#keys#ToggleTabMode()
  AssertEqual 0, b:songwriter_tabmode

Given songwriter (w stays put on a prose line even in tablature mode (function no-op)):
  I walk a

Execute (w stays put on a prose line even in tablature mode (function no-op)):
  let b:songwriter_tabmode = 1
  call cursor(1, 1)
  call songwriter#tab#MoveNote(1)
Then:
  AssertEqual 1, col('.')

Given songwriter (l stays put on a prose line even in tablature mode (function no-op)):
  I walk a

Execute (l stays put on a prose line even in tablature mode (function no-op)):
  let b:songwriter_tabmode = 1
  call cursor(1, 1)
  call songwriter#tab#MoveColumn(1)
Then:
  AssertEqual 1, col('.')
